---
import { NAV } from '../config/site';
import mark from '../assets/brand/logo-mark.webp';
// Client logo (Nov 2026): the globe-and-leaves mark, cut from the client's
// 'Laughing Earth Logo.jpeg' onto transparency, plus the name as live text.
// Imported from src/assets so the built file name is hashed (no stale caches).
interface Props {
  href?: string;
  class?: string;
}

const { href = NAV.landscaping.href, class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  href={href || undefined}
  class:list={['logo', className]}
  aria-label={href ? 'Laughing Earth — home' : undefined}
>
  <img
    class="logo__mark"
    src={mark.src}
    width="48"
    height="48"
    alt=""
    decoding="async"
  />
  <span class="logo__word">Laughing Earth</span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: var(--tap-target);
    color: inherit;
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
    font-size: 1.375rem;
  }

  .logo__mark {
    width: 1.6em;
    height: 1.6em;
    flex: none;
    object-fit: contain;
  }

</style>
