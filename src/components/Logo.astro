---
// Placeholder logo (sprout mark + wordmark) until the client supplies final
// logo files — see IMAGES-NEEDED.md. Colours follow the current theme.
interface Props {
  href?: string;
  size?: 'sm' | 'lg';
  class?: string;
}

const { href = '/', size = 'sm', class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  href={href || undefined}
  class:list={['logo', `logo--${size}`, className]}
  aria-label={href ? 'Laughing Earth — home' : undefined}
>
  <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <circle cx="24" cy="24" r="22" class="logo__disc" />
    <path class="logo__leaf logo__leaf--a" d="M24 34c0-9 5-15 14-16-1 9-6 15-14 16Z" />
    <path class="logo__leaf logo__leaf--b" d="M24 34c0-7-4-12-12-13 1 8 5 12 12 13Z" />
    <path class="logo__stem" d="M24 38V27" />
  </svg>
  <span class="logo__word">Laughing Earth</span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: var(--tap-target);
    color: inherit;
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }

  .logo--sm {
    font-size: 1.375rem;
  }

  .logo--lg {
    flex-direction: column;
    gap: 0.35em;
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem);
  }

  .logo__mark {
    width: 1.6em;
    height: 1.6em;
    flex: none;
  }

  .logo--lg .logo__mark {
    width: 1.9em;
    height: 1.9em;
  }

  .logo__disc {
    fill: var(--btn-bg);
  }

  .logo__leaf--a {
    fill: var(--btn-text);
  }

  .logo__leaf--b {
    fill: color-mix(in srgb, var(--btn-text) 70%, var(--btn-bg));
  }

  .logo__stem {
    stroke: var(--btn-text);
    stroke-width: 2.2;
    stroke-linecap: round;
    fill: none;
  }
</style>
