---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, POLICIES, SITE, whatsappLink, WHATSAPP_MESSAGES } from '../config/site';

// Site footer on the theme's deep tone. The year is set at build time and
// refreshed in the browser so it is always the current year.
const year = new Date().getFullYear();
const a = SITE.address;
---

<footer class="site-footer textured" data-tone="deep">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo />
      <p>{SITE.brandLine}</p>
      <a class="site-footer__social" href={SITE.instagram} target="_blank" rel="noopener noreferrer">
        <Icon name="instagram" size={22} />
        <span>Follow us on Instagram</span>
      </a>
    </div>

    <nav aria-labelledby="footer-explore">
      <h2 id="footer-explore" class="site-footer__heading">Explore</h2>
      <ul>
        {Object.values(NAV).map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-labelledby="footer-policies">
      <h2 id="footer-policies" class="site-footer__heading">Policies</h2>
      <ul>
        {POLICIES.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="site-footer__heading">Visit or call</h2>
      <address>
        <p class="site-footer__line">
          <Icon name="pin" size={20} />
          <span>{a.street}, {a.locality}, {a.city}, {a.region} {a.postalCode}</span>
        </p>
        <p class="site-footer__line">
          <Icon name="phone" size={20} />
          <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a>
        </p>
        <p class="site-footer__line">
          <Icon name="whatsapp" size={20} />
          <a
            href={whatsappLink(WHATSAPP_MESSAGES.general)}
            target="_blank"
            rel="noopener noreferrer"
            data-event="whatsapp_click"
            data-event-label="footer"
          >WhatsApp us</a>
        </p>
        <p class="site-footer__line">
          <Icon name="mail" size={20} />
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </address>
    </div>
  </div>

  {Astro.slots.has('credits') && <div class="container site-footer__credits"><slot name="credits" /></div>}

  <p class="site-footer__wordmark" aria-hidden="true">{SITE.name}</p>

  <div class="container site-footer__base">
    <p>&copy; <span data-current-year>{year}</span> {SITE.name}. All rights reserved.</p>
    <p>{SITE.credit.label}</p>
  </div>
</footer>

<script>
  document.querySelectorAll('[data-current-year]').forEach((el) => {
    el.textContent = String(new Date().getFullYear());
  });
</script>

<style>
  .site-footer {
    background: var(--bg);
    color: var(--text);
    padding-block: var(--space-8) var(--space-9);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-7) var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 1.6fr;
    }
  }

  .site-footer__brand {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    justify-items: start;
    max-width: 34ch;
  }

  .site-footer__brand p {
    color: var(--muted);
  }

  .site-footer__heading {
    margin-bottom: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-16);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--heading);
  }

  ul {
    list-style: none;
    padding: 0;
  }

  li a,
  .site-footer__social {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
  }

  a {
    color: var(--text);
    text-decoration-color: color-mix(in srgb, var(--link) 70%, transparent);
  }

  a:hover {
    color: var(--link);
  }

  address {
    font-style: normal;
    display: grid;
    gap: var(--space-2);
  }

  .site-footer__line {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: var(--space-3);
    align-items: center;
    min-height: var(--tap-target);
  }

  .site-footer__line :global(svg) {
    color: var(--icon);
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  .site-footer__credits {
    margin-top: var(--space-7);
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .site-footer__credits :global(p) {
    max-width: 75ch;
  }

  .site-footer__credits :global(a) {
    color: inherit;
  }

  /* The giant name only closes the Landscaping page */
  .site-footer__wordmark {
    display: none;
  }

  /* ---- Landscaping: the name returns at full width, no rules or tracked caps ---- */
  :global([data-theme='landscaping']) .site-footer {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-block: var(--space-8) var(--space-4);
  }

  :global([data-theme='landscaping']) .site-footer__heading {
    font-size: var(--text-18);
    letter-spacing: 0;
    text-transform: none;
  }

  :global([data-theme='landscaping']) .site-footer__wordmark {
    display: block;
    padding-inline: var(--gutter);
    margin-top: auto;
    padding-top: var(--space-8);
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    /* "LAUGHING EARTH" sets about 5.9× its size wide: fill the margins exactly */
    font-size: calc((100vw - 2 * var(--gutter)) / 6);
    line-height: 0.8;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--heading);
  }

  :global([data-theme='landscaping']) .site-footer__base {
    margin-top: var(--space-4);
    padding-top: 0;
    border-top: 0;
  }
</style>
