---
import { withBase } from '../lib/url';
// Muted, looping background video. Phones get the 360p file, larger screens
// 720p; with `hd`, phones get 720p and larger screens 1080p. Playback is
// managed by src/scripts/motion/video.ts: it plays only while on screen and
// never autoplays for reduced motion (the poster shows instead).
interface Props {
  /** Path without suffix, e.g. /videos/gifts-hero-watering-plant → -720.mp4 / -360.mp4 */
  src: string;
  /** Use the -1080.mp4 (768px and up) / -720.mp4 (phones) pair instead */
  hd?: boolean;
  poster: string;
  class?: string;
  /** Load straight away (hero) instead of when near the viewport */
  eager?: boolean;
  /** Needed when a pause button points at it (aria-controls) */
  id?: string;
}

const { src: path, poster: posterPath, class: className, eager = false, id, hd = false } = Astro.props;
const src = withBase(path);
const [large, small] = hd ? ['1080', '720'] : ['720', '360'];
const poster = withBase(posterPath);
---

<video
  id={id}
  class:list={['bg-video', className]}
  data-video
  poster={poster}
  muted
  loop
  playsinline
  disablepictureinpicture
  preload={eager ? 'auto' : 'none'}
  aria-hidden="true"
  tabindex="-1"
>
  <source src={`${src}-${large}.mp4`} type="video/mp4" media="(min-width: 768px)" />
  <source src={`${src}-${small}.mp4`} type="video/mp4" />
</video>

<style>
  .bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
</style>
