---
// Eyebrow + H2 + optional lead, used at the top of most sections.
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
}

const { id, eyebrow, title, lead, align = 'start' } = Astro.props;
---

<div class:list={['section-header', `section-header--${align}`]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>

<style>
  .section-header {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }

  .section-header--center {
    justify-items: center;
    text-align: center;
  }
</style>
