---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV } from '../config/site';

// Sticky header with the Landscaping / Return Gifts switch.
// Inherits the page theme; the active side of the switch matches the page.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href;
---

<header class="site-header">
  <div class="site-header__bar container">
    <Logo />

    <nav class="switch" aria-label="Choose a business">
      {
        [NAV.landscaping, NAV.gifts].map((item) => (
          <a
            href={item.href}
            class="switch__option"
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <nav class="site-nav" aria-label="Main">
      <button
        class="site-nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav-list"
      >
        <Icon name="menu" class="site-nav__icon-open" />
        <Icon name="close" class="site-nav__icon-close" />
        <span class="sr-only">Menu</span>
      </button>
      <ul id="site-nav-list" class="site-nav__list">
        {
          [NAV.about, NAV.contact].map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-nav__toggle');
  const list = document.getElementById('site-nav-list');

  if (toggle && list) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      list.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--header-bg);
    color: var(--header-text);
    border-bottom: 1px solid var(--header-border);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    --focus: var(--switch-active-bg);
  }

  .site-header__bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'logo nav'
      'switch switch';
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-2) var(--space-3);
  }

  .site-header__bar > :global(.logo) {
    grid-area: logo;
    justify-self: start;
  }

  /* ---- Switch ---- */
  .switch {
    grid-area: switch;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: var(--switch-track);
    box-shadow: inset 0 2px 6px rgb(0 0 0 / 0.12);
  }

  .switch__option {
    display: grid;
    place-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--space-4);
    border-radius: var(--radius-pill);
    color: var(--switch-text);
    font-size: var(--text-16);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .switch__option:hover {
    background: color-mix(in srgb, var(--switch-active-bg) 18%, transparent);
  }

  .switch__option[aria-current='page'] {
    background: var(--switch-active-bg);
    color: var(--switch-active-text);
    box-shadow: var(--shadow-small);
  }

  .switch__option:focus-visible {
    border-radius: var(--radius-pill);
    outline-offset: 1px;
  }

  /* ---- Secondary nav ---- */
  .site-nav {
    grid-area: nav;
    position: relative;
  }

  .site-nav__toggle {
    display: grid;
    place-items: center;
    width: var(--tap-target);
    height: var(--tap-target);
    border: 1px solid var(--header-border);
    border-radius: 50%;
    background: transparent;
    color: inherit;
  }

  /* Icon is a child component, so its classes need :global */
  .site-nav__toggle :global(.site-nav__icon-close),
  .site-nav__toggle[aria-expanded='true'] :global(.site-nav__icon-open) {
    display: none;
  }

  .site-nav__toggle[aria-expanded='true'] :global(.site-nav__icon-close) {
    display: block;
  }

  .site-nav__list {
    display: none;
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    min-width: 12rem;
    padding: var(--space-2);
    list-style: none;
    border-radius: var(--radius-card);
    background: var(--switch-track);
    box-shadow: var(--shadow-soft);
  }

  .site-nav__list.is-open {
    display: block;
  }

  .site-nav__list a {
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--space-4);
    border-radius: var(--radius-pill);
    color: var(--switch-text);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .site-nav__list a:hover,
  .site-nav__list a[aria-current='page'] {
    background: color-mix(in srgb, var(--switch-active-bg) 22%, transparent);
  }

  /* ---- Tablet and up: one row ---- */
  @media (min-width: 768px) {
    .site-header__bar {
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas: 'logo switch nav';
      padding-block: var(--space-3);
    }

    .site-nav {
      justify-self: end;
    }

    .site-nav__toggle {
      display: none;
    }

    .site-nav__list {
      position: static;
      display: flex;
      gap: var(--space-1);
      min-width: 0;
      padding: 0;
      background: none;
      box-shadow: none;
    }

    .site-nav__list a {
      color: var(--header-text);
    }
  }
  /* ---- Landscaping: a plain bar, separated by tone only ---- */
  :global([data-theme='landscaping']) .site-header {
    border-bottom: 0;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  :global([data-theme='landscaping']) .switch,
  :global([data-theme='landscaping']) .switch__option[aria-current='page'] {
    box-shadow: none;
  }

  :global([data-theme='landscaping']) .site-nav__toggle {
    border-color: transparent;
    background: var(--switch-track);
  }
</style>
