---
import Card from './Card.astro';
import Button from './Button.astro';
import { whatsappLink } from '../config/site';

// One catalogue item: photo, name, price with MRP struck through, and a
// WhatsApp quote link naming the product. The <li> carries data-category for
// the client-side filter.
interface Props {
  product: {
    name: string;
    slug: string;
    category: string;
    price: number;
    mrp: number;
    image: string;
    description: string;
  };
  categoryName: string;
}

const { product: p, categoryName } = Astro.props;
const rupees = (n: number) => `₹${n.toLocaleString('en-IN')}`;
const message = `Hi Laughing Earth! I'd like a quote for "${p.name}" (${rupees(p.price)} each). Quantity: ___ Event date: ___`;
---

<li class="product" data-category={p.category}>
  <Card class="product__card">
    <img
      slot="media"
      src={`${p.image}-400.webp`}
      srcset={`${p.image}-400.webp 400w, ${p.image}.webp 800w`}
      sizes="(min-width: 1024px) 270px, (min-width: 768px) 30vw, 46vw"
      width="800"
      height="800"
      alt={p.name}
      loading="lazy"
      decoding="async"
      data-clip-reveal
    />
    <p class="product__category">{categoryName}</p>
    <h3 class="product__name">{p.name}</h3>
    <p class="product__description">{p.description}</p>
    <p class="product__price">
      <span class="product__now"><span class="sr-only">Price: </span>{rupees(p.price)}</span>
      {
        p.mrp > p.price && (
          <s class="product__mrp">
            <span class="sr-only">MRP: </span>
            {rupees(p.mrp)}
          </s>
        )
      }
      <span class="product__unit">each</span>
    </p>
    <Button
      href={whatsappLink(message)}
      icon="whatsapp"
      iconPosition="start"
      external
      class="product__cta"
      data-event="whatsapp_click"
      data-event-label={`product_${p.slug}`}
    >
      Get quote<span class="sr-only"> for {p.name} on WhatsApp</span>
    </Button>
  </Card>
</li>

<style>
  .product[hidden] {
    display: none;
  }

  .product :global(.product__card) {
    height: 100%;
  }

  .product :global(.card__media) {
    padding: var(--space-2) var(--space-2) 0;
  }

  .product :global(.card__body) {
    flex: 1;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3) var(--space-4);
  }

  .product__category {
    font-size: var(--text-16);
    font-weight: var(--weight-semibold);
    line-height: 1.3;
    color: color-mix(in srgb, var(--card-text) 78%, var(--card-bg));
  }

  .product__name {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.2;
  }

  .product__description {
    display: none;
    color: var(--card-text);
  }

  .product__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-2);
    margin-top: auto;
    padding-top: var(--space-1);
  }

  .product__now {
    font-family: var(--font-heading);
    font-size: var(--text-24);
    font-weight: var(--weight-heading);
    color: var(--card-heading);
  }

  .product__mrp,
  .product__unit {
    font-size: var(--text-16);
    color: color-mix(in srgb, var(--card-text) 80%, var(--card-bg));
  }

  .product :global(.product__cta) {
    width: 100%;
    padding-inline: var(--space-3);
  }

  @media (min-width: 768px) {
    .product :global(.card__body) {
      padding: var(--space-4) var(--space-4) var(--space-5);
    }

    .product__description {
      display: block;
      font-size: var(--text-16);
    }
  }
</style>
