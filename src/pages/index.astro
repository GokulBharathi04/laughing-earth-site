---
import { withBase } from '../lib/url';
import { NAV, SITE } from '../config/site';

// The site's front door. The logo film that used to play here was removed at
// the client's request (November 2026), so this address goes straight to the
// Landscaping page. The film's files are still in public/ if it is wanted back;
// the previous version of this file is in git history.
const next = `${NAV.landscaping.href}/`;
const canonical = new URL(next, Astro.site);
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.name} | Landscaping & Eco-friendly Return Gifts in Chennai</title>
    <meta
      name="description"
      content="Laughing Earth, Villivakkam, Chennai: garden design and landscaping services, plus eco-friendly seeded return gifts, potted plants and thamboolam bags."
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <meta name="theme-color" content="#15140E" />
    <meta http-equiv="refresh" content={`0;url=${next}`} />
    <script is:inline define:vars={{ next }}>
      location.replace(next); // replace(), so Back never lands here again
    </script>
  </head>
  <body style="margin:0;background:#15140e;color:#f8efda;font-family:system-ui,sans-serif">
    <h1 style="position:absolute;left:-9999px">{SITE.name}</h1>
    <p style="padding:24px"><a href={next} style="color:inherit">Continue to {SITE.name}</a></p>
  </body>
</html>
