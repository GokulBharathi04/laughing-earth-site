---
import GiftsLayout from '../layouts/GiftsLayout.astro';
import ArrowButton from '../components/ArrowButton.astro';
import Icon from '../components/Icon.astro';
import QuoteBuilder from '../components/QuoteBuilder.astro';
import BgVideo from '../components/BgVideo.astro';
import catalogue from '../../data/products.json';
import credits from '../../data/gifts-credits.json';
import { withBase } from '../lib/url';
import { SITE, whatsappLink, WHATSAPP_MESSAGES } from '../config/site';

const { categories, products } = catalogue;
const categoryName = Object.fromEntries(categories.map((c) => [c.slug, c.name]));
const countIn = (slug: string) => products.filter((p) => p.category === slug).length;

// One photograph per kind of gift, taken from the catalogue itself.
const kinds = [
  { slug: 'plants', image: '/images/product-little-smiles' },
  { slug: 'seeded-return-gifts', image: '/images/product-butterfly-box' },
  { slug: 'seed-paper-invitations', image: '/images/product-aesthetic-seed-paper-wedding-card' },
  { slug: 'thamboolam-bags', image: '/images/product-thamboolam-bags' },
] as const;

const facts = ['Priced per piece', 'Customised with your names', 'Bulk orders welcome'];
const featured = products[0];

type Product = (typeof products)[number];
const rupees = (n: number) => `₹${n.toLocaleString('en-IN')}`;
const priceLine = (p: Product) =>
  [p.price == null ? 'Price on request' : `${'priceFrom' in p && p.priceFrom ? 'from ' : ''}${rupees(p.price)} each`, 'moq' in p && p.moq ? `minimum ${p.moq}` : '']
    .filter(Boolean)
    .join(' · ');
const quoteMessage = (p: Product) =>
  `Hi Laughing Earth! I'd like a quote for "${p.name}"${p.price == null ? '' : ` (${'priceFrom' in p && p.priceFrom ? 'from ' : ''}${rupees(p.price)} each)`}. Quantity: ___ Event date: ___`;

const bulk = [
  { icon: 'boxes', title: 'Minimum order', text: 'From 25 pieces for plants and saplings, 50 to 100 for seeded gifts. Each gift lists its own.' },
  { icon: 'pen', title: 'Customisation', text: 'Names, dates and logos printed on bags, cards and tags.' },
  { icon: 'clock', title: 'Lead time', text: 'Order <mark class="tbc">to confirm</mark> before your event.' },
  { icon: 'truck', title: 'Delivery', text: 'Across Chennai. Other areas <mark class="tbc">to confirm</mark>.' },
] as const;

// Stock footage (Mixkit free licence) until the client's own event videos
// arrive; see IMAGES-NEEDED.md.
const clip = (name: string) => ({ video: `/videos/${name}`, poster: `/images/poster-${name}.webp` });
const gallery = [
  { ...clip('gallery-wedding-table'), caption: 'Weddings', alt: 'A wedding table decorated with flowers' },
  { ...clip('gallery-gifts-at-the-door'), caption: 'Housewarmings', alt: 'Guests arriving at a front door with gifts' },
  { ...clip('gallery-giving-a-gift'), caption: 'Birthdays & thank-yous', alt: 'One person handing a small wrapped gift to another' },
  { ...clip('gallery-succulent-closeup'), caption: 'Plants that last', alt: 'Close-up of succulent leaves' },
  { ...clip('gallery-planting-seeds'), caption: 'Seeds that sprout', alt: 'Hands planting seeds in garden soil' },
  { ...clip('gallery-flower-shop'), caption: 'Made to order', alt: 'Shelves of fresh flowers and plants in a shop' },
];

const faqs = [
  {
    q: 'Is there a minimum order?',
    a: '<p>Yes. Plants and saplings start at 25 pieces, potlis at 50, and butterfly boxes and seed pens at 100. Customised single seed balls start at 1,000. Each gift in the catalogue shows its minimum. Tell us your guest count and we will suggest what works.</p>',
  },
  {
    q: 'Can you print our names and wedding date?',
    a: '<p>Yes. Thamboolam bags, thank-you cards and seed-paper invitations can carry your names, the date or a logo. Share the wording on WhatsApp and we will send a preview before printing.</p>',
  },
  {
    q: 'How early should we place the order?',
    a: '<p>Ideally <mark class="tbc">to confirm</mark> before the event, so plants are fresh and printing is checked. For large orders, reach out as soon as your date is fixed.</p>',
  },
  {
    q: 'Do you deliver to the venue?',
    a: '<p>We deliver across Chennai. Delivery to other cities and venue drop-offs are <mark class="tbc">to confirm</mark>; ask us with your area and date.</p>',
  },
  {
    q: 'How do seed-paper invitations grow?',
    a: '<p>Soak the card in water for a few hours, lay it on moist soil, cover it lightly and keep it damp in a sunny spot. Sprouts usually appear within a couple of weeks. <mark class="tbc">Client to review</mark></p>',
  },
  {
    q: 'How do we pay?',
    a: '<p>There is no online checkout. Once your quote is confirmed on WhatsApp, we share payment details directly.</p>',
  },
];
---

<GiftsLayout
  title="Eco-friendly Return Gifts, Seed-paper Invitations & Thamboolam Bags in Chennai"
  description="Seeded return gifts, seed-paper wedding invitations, customisable thamboolam bags and potted plants for weddings and events in Chennai. Prices per piece; bulk quotes on WhatsApp."
>
  <!-- Hero: full-bleed film; it stays put while the next section slides over it -->
  <section class="g-sec g-hero tone-media" data-header="light" aria-labelledby="gifts-hero-title">
    <BgVideo id="gifts-hero-video" class="g-bleed" src="/videos/gifts-hero-watering-plant" poster="/images/poster-gifts-hero-watering-plant.webp" eager />
    <div class="g-hero__shade" aria-hidden="true"></div>
    <button class="g-hero__toggle" type="button" data-video-toggle aria-controls="gifts-hero-video" aria-pressed="false" aria-label="Pause background video">
      <Icon name="pause" size={16} class="is-pause" />
      <Icon name="play" size={16} class="is-play" />
    </button>
    <div class="g-wrap g-hero__inner">
      <p class="g-label g-eyebrow">Return gifts · Chennai</p>
      <h1 id="gifts-hero-title" class="g-h1">Return gifts that keep on growing</h1>
      <div class="g-hero__cta">
        <ArrowButton href="#catalogue">Browse the gifts</ArrowButton>
        <a class="g-textlink" href={whatsappLink(WHATSAPP_MESSAGES.gifts)} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-event-label="gifts_hero">Get a quote on WhatsApp</a>
      </div>
      <div class="g-hero__bottom">
        <div>
          <p class="g-hero__lead">
            Seeded gifts, seed-paper invitations, thamboolam bags and potted plants for weddings, housewarmings and every
            celebration in between.
          </p>
          <ul class="g-facts">
            {facts.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <a class="g-feature" href="#catalogue" data-filter-link={featured.category}>
          <img src={withBase(`${featured.image}-400.webp`)} width="400" height="400" alt="" />
          <span>
            <span class="g-label">Featured gift</span>
            <strong>{featured.name}</strong>
            <small>{priceLine(featured)}</small>
          </span>
          <span class="abtn__arw" aria-hidden="true"><Icon name="arrow-right" size={15} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Statement: pinned while the second sentence takes over -->
  <section class="g-sec g-statement tone-media" data-header="light" aria-labelledby="statement-title">
    <BgVideo class="g-bleed" src="/videos/gifts-band-planting-seedling" poster="/images/poster-gifts-band-planting-seedling.webp" />
    <div class="g-statement__shade" aria-hidden="true"></div>
    <div class="g-wrap g-statement__inner">
      <p class="g-label g-eyebrow">From a seed to a smile</p>
      <div class="g-statement__lines">
        <h2 id="statement-title" class="g-say">
          Every gift we make starts with something
          <span class="g-ipill"><img src={withBase('/images/poster-gallery-planting-seeds.webp')} alt="" /></span>
          that grows.
        </h2>
        <p class="g-say">
          Your guests take home a sapling, a seed or a plant,
          <span class="g-ipill"><img src={withBase(`${featured.image}-400.webp`)} alt="" /></span>
          and a reason to remember the day.
        </p>
      </div>
    </div>
  </section>

  <!-- Kinds of gift: pinned words left, cards scroll right -->
  <section class="g-sec g-kinds tone-cream" id="kinds" data-header="dark" aria-labelledby="kinds-title">
    <div class="g-wrap g-split" data-pin-left>
      <div class="g-split__left">
        <p class="g-label g-eyebrow">Four ways to say thank you</p>
        <h2 id="kinds-title" class="g-h2" data-split>Choose your kind of gift</h2>
        <p class="g-lead">Priced per piece, customised with your names, and made for bulk orders.</p>
        <ArrowButton href="#catalogue" data-filter-link="all" data-rise>See all {products.length} gifts</ArrowButton>
      </div>
      <ul class="g-cards">
        {
          kinds.map((k, i) => (
            <li>
              <a class="g-kind" href="#catalogue" data-filter-link={k.slug}>
                <div class="g-kind__media" data-reveal>
                  <img src={withBase(`${k.image}.webp`)} width="800" height="800" alt="" loading="lazy" decoding="async" />
                </div>
                <div class="g-kind__row">
                  <h3 class="g-h3">{categoryName[k.slug]}</h3>
                  <span class="abtn__arw" aria-hidden="true"><Icon name="arrow-right" size={15} /></span>
                </div>
                <div class="g-kind__meta">
                  <span class="g-label">{String(i + 1).padStart(2, '0')}</span>
                  <p>{categories.find((c) => c.slug === k.slug)?.blurb}</p>
                  <span class="g-label">
                    {countIn(k.slug)} {countIn(k.slug) === 1 ? 'gift' : 'gifts'}
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Strip: what we make, drifting past -->
  <div class="g-sec g-strip tone-forest" data-header="light" aria-hidden="true">
    <div class="g-strip__track">
      {
        [0, 1].map(() => (
          <div class="g-strip__group">
            {['Seeded return gifts', 'Seed-paper invitations', 'Thamboolam bags', 'Plants in jute', 'Made in Chennai'].map((word) => (
              <span class="g-strip__item">
                {word}
                <Icon name="leaf" size={22} />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Catalogue -->
  <section class="g-sec g-catalogue tone-forest" id="catalogue" data-header="light" aria-labelledby="catalogue-title">
    <div class="g-wrap" data-catalogue>
      <div class="g-sechead">
        <div>
          <p class="g-label g-eyebrow">Catalogue</p>
          <h2 id="catalogue-title" class="g-h2" data-split>Gifts and prices</h2>
        </div>
        <p class="g-catalogue__status" data-catalogue-status aria-live="polite">Showing {products.length} gifts</p>
      </div>
      <div class="g-filters" role="group" aria-label="Filter by kind of gift">
        <button type="button" class="g-filter g-label" data-filter="all" aria-pressed="true">All</button>
        {
          categories.map((c) => (
            <button type="button" class="g-filter g-label" data-filter={c.slug} aria-pressed="false">
              {c.name}
            </button>
          ))
        }
      </div>
      <ul class="g-products">
        {
          products.map((p) => (
            <li class="g-product" data-category={p.category}>
              <article class="g-product__card">
                <div class="g-product__media">
                  <img
                    src={withBase(`${p.image}-400.webp`)}
                    srcset={`${withBase(`${p.image}-400.webp`)} 400w, ${withBase(`${p.image}.webp`)} 800w`}
                    sizes="(min-width: 1100px) 340px, (min-width: 641px) 32vw, 48vw"
                    width="800"
                    height="800"
                    alt={p.name}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="g-product__body">
                  <p class="g-label g-product__cat">{categoryName[p.category]}</p>
                  <h3 class="g-product__name">{p.name}</h3>
                  <p class="g-product__desc">{p.description}</p>
                  <p class="g-product__price">
                    <span>
                      {p.price == null ? (
                        <span class="g-product__unit">Price on request</span>
                      ) : (
                        <>
                          {'priceFrom' in p && p.priceFrom && <span class="g-product__unit">from </span>}
                          <span class="g-product__now">
                            <span class="sr-only">Price: </span>
                            {rupees(p.price)}
                          </span>
                          <span class="g-product__unit"> each</span>
                          {'mrp' in p && p.mrp && p.mrp > p.price && (
                            <s class="g-product__unit">
                              {' '}
                              <span class="sr-only">MRP: </span>
                              {rupees(p.mrp)}
                            </s>
                          )}
                        </>
                      )}
                    </span>
                    {'moq' in p && p.moq && (
                      <span class="g-product__moq">
                        Min. {p.moq.toLocaleString('en-IN')}
                        {'moqNote' in p && p.moqNote ? ` ${p.moqNote}` : ''}
                      </span>
                    )}
                  </p>
                  <ArrowButton
                    href={whatsappLink(quoteMessage(p))}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-event="whatsapp_click"
                    data-event-label={`product_${p.slug}`}
                  >
                    Get a quote<span class="sr-only"> for {p.name} on WhatsApp</span>
                  </ArrowButton>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Bulk orders: a ruled table -->
  <section class="g-sec g-bulk tone-cream" id="bulk" data-header="dark" aria-labelledby="bulk-title">
    <div class="g-wrap g-split">
      <div class="g-split__left">
        <p class="g-label g-eyebrow">Weddings &amp; events</p>
        <h2 id="bulk-title" class="g-h2" data-split>Ordering for a crowd?</h2>
        <p class="g-lead">Tell us the occasion, guest count and date. We'll suggest gifts that suit your budget and send a quote.</p>
        <div class="g-bulk__actions" data-rise>
          <ArrowButton data-morph-open="quote-builder">Build a bulk quote</ArrowButton>
          <span>or call <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a></span>
        </div>
      </div>
      <dl class="g-table">
        {
          bulk.map((b) => (
            <div class="g-table__row">
              <Icon name={b.icon} size={26} />
              <dt class="g-h3">{b.title}</dt>
              <dd set:html={b.text} />
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Celebrations: thumbnails, words, film -->
  <section class="g-sec g-gallery tone-deep" id="celebrations" data-header="light" aria-labelledby="gallery-title">
    <div class="g-wrap" data-gallery>
      <p class="g-label g-eyebrow">Event gallery</p>
      <h2 id="gallery-title" class="g-h2" data-split>Gifts for every celebration</h2>
      <div class="g-gallery__stage">
        <div class="g-thumbs" role="group" aria-label="Choose a celebration">
          {
            gallery.map((g, i) => (
              <button type="button" class="g-thumb" data-thumb aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Show ${g.caption}`}>
                <img src={withBase(g.poster)} width="1280" height="720" alt="" loading="lazy" decoding="async" />
              </button>
            ))
          }
        </div>
        <div class="g-gallery__words">
          <div class="g-caps" aria-live="polite">
            {
              gallery.map((g, i) => (
                <div class:list={['g-cap', i === 0 && 'on']} aria-hidden={i === 0 ? 'false' : 'true'}>
                  <p class="g-label g-eyebrow">{String(i + 1).padStart(2, '0')}</p>
                  <h3>{g.caption}</h3>
                  <p>{g.alt}.</p>
                </div>
              ))
            }
          </div>
          <div class="g-gallery__nav">
            <span class="g-label g-count" data-count>01 / {String(gallery.length).padStart(2, '0')}</span>
            <div class="g-progress" aria-hidden="true"><i data-progress></i></div>
            <button type="button" class="g-arrow g-arrow--prev" data-prev aria-label="Previous celebration"><Icon name="arrow-right" size={18} /></button>
            <button type="button" class="g-arrow" data-next aria-label="Next celebration"><Icon name="arrow-right" size={18} /></button>
          </div>
        </div>
        <div class="g-gallery__media">
          {
            gallery.map((g, i) => (
              <div class:list={['g-slide', i === 0 && 'on']}>
                <BgVideo src={g.video} poster={g.poster} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Simple to order: three ruled cells -->
  <section class="g-sec g-promise tone-cream" data-header="dark" aria-labelledby="promise-title">
    <div class="g-wrap">
      <p class="g-label g-eyebrow">How it works</p>
      <h2 id="promise-title" class="g-h2" data-split>Simple to order</h2>
      <ul class="g-cells">
        {
          facts.map((f, i) => (
            <li class="g-cell" data-rise>
              <p class="g-label">{String(i + 1).padStart(2, '0')}</p>
              <p>{f}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Questions: pinned picture, ruled answers -->
  <section class="g-sec g-faq tone-forest" id="questions" data-header="light" aria-labelledby="faq-title">
    <div class="g-wrap g-split" data-pin-left>
      <div class="g-split__left">
        <p class="g-label g-eyebrow">Good to know</p>
        <h2 id="faq-title" class="g-h2" data-split>Questions about bulk orders</h2>
        <div class="g-faq__media" data-reveal>
          <img src={withBase('/images/poster-gallery-succulent-closeup.webp')} width="1280" height="720" alt="Close-up of succulent leaves" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="g-qa">
        {
          faqs.map((f) => (
            <details class="g-q" name="gift-faq">
              <summary>
                <span>{f.q}</span>
                <span class="g-q__icon" aria-hidden="true"><Icon name="plus" size={16} /></span>
              </summary>
              <div class="g-q__a" set:html={f.a} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="g-sec g-cta tone-media" data-header="light" aria-labelledby="cta-title">
    <BgVideo class="g-bleed" src="/videos/gallery-wedding-table" poster="/images/poster-gallery-wedding-table.webp" />
    <div class="g-cta__shade" aria-hidden="true"></div>
    <div class="g-wrap g-cta__inner">
      <p class="g-label g-eyebrow">Weddings, housewarmings, birthdays</p>
      <h2 id="cta-title" class="g-h2" data-split>Planning a wedding or a big celebration?</h2>
      <p class="g-lead">Send us the date and guest count. We'll reply on WhatsApp with ideas and a quote.</p>
      <div class="g-cta__actions" data-rise>
        <ArrowButton href={whatsappLink(WHATSAPP_MESSAGES.gifts)} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-event-label="gifts_cta">Get a quote on WhatsApp</ArrowButton>
        <ArrowButton variant="line" data-morph-open="quote-builder">Build a bulk quote</ArrowButton>
      </div>
    </div>
  </section>

  <p slot="credits" class="g-credits">
    Product photographs are stand-ins from Wikimedia Commons until our own arrive:
    {
      credits.map((c, i) => (
        <>
          <a href={c.page} target="_blank" rel="noopener noreferrer">{c.title}</a>
          {c.creator ? ` by ${c.creator}` : ''}, {c.licenseUrl ? <a href={c.licenseUrl} target="_blank" rel="noopener noreferrer">{c.license}</a> : c.license}
          {i < credits.length - 1 ? '; ' : '. '}
        </>
      ))
    }
    Video clips from Mixkit (free licence).
  </p>

  <QuoteBuilder slot="after" gifts={categories.map((c) => c.name)} />
</GiftsLayout>
