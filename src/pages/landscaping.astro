---
import { withBase } from '../lib/url';
import LandscapeLayout from '../layouts/LandscapeLayout.astro';
import Icon from '../components/Icon.astro';
import PypCredit from '../components/PypCredit.astro';
import mark from '../assets/brand/logo-mark.webp';
import { SITE, NAV, POLICIES, whatsappLink, WHATSAPP_MESSAGES } from '../config/site';

// Three parts, in the order the client set out:
//  1. the banner and its enquiry card, exactly as on the previous version;
//  2. the services, on a turning 3D ring (src/scripts/landscaping/service-ring.ts);
//  3. about, vision and commitment, and contact, laid out as in the
//     "Laughing Earth Landscape Studio" reference page, in this site's dusk palette.

// Pictures cut to size in /images/land-studio (see IMAGES-NEEDED.md).
const pic = (file: string) => withBase(`/images/land-studio/${file}`);

// Each service: the reference page's line, and what it includes, taken from
// that same line. The card shows the picture and name; the details panel shows
// the rest. detail = 4:5 picture for the panel (its own pixel size), wide = 4:3
// picture for the panel on phones.
const services = [
  {
    name: 'Landscape design',
    slug: 'svc-landscape-design',
    detail: [800, 1000],
    text: 'Thoughtfully planned green spaces with trees, palms, plants, lawns, shrubs, flower beds and ground covers.',
    includes: ['Trees and palms', 'Plants and shrubs', 'Lawns', 'Flower beds', 'Ground covers'],
    alt: 'A lawn garden with palms, flowering shrubs, a stone path, a lily pond with a fountain and a pergola',
  },
  {
    name: 'Hardscape design',
    slug: 'svc-hardscape-design',
    detail: [800, 1000],
    text: 'Natural stone paving, pathways, driveways, retaining walls, pergolas, garden steps, fountains and seating areas.',
    includes: ['Natural stone paving', 'Pathways and driveways', 'Retaining walls', 'Pergolas', 'Garden steps', 'Fountains and seating areas'],
    alt: 'A natural stone patio with broad steps, retaining walls, a fountain, a pergola and built-in seating',
  },
  {
    name: 'Landscape maintenance',
    slug: 'svc-landscape-maintenance',
    detail: [800, 1000],
    text: 'Mowing, pruning, trimming, fertilisation, weed control, irrigation management and seasonal care, all year round.',
    includes: ['Mowing, pruning and trimming', 'Fertilisation', 'Weed control', 'Irrigation management', 'Seasonal care, all year round'],
    alt: 'A freshly mown striped lawn with a mower, a wheelbarrow of tools and a sprinkler running',
  },
  {
    name: 'Gardening services',
    slug: 'svc-gardening-services',
    detail: [800, 1000],
    text: 'Plant selection, garden setup, soil preparation, potting, repotting, planting and general garden care.',
    includes: ['Plant selection', 'Garden setup', 'Soil preparation', 'Potting and repotting', 'Planting and general garden care'],
    alt: 'Potted plants, soil, a watering can and hand tools set out on a stone courtyard for planting',
  },
  {
    name: 'Miyawaki & butterfly gardens',
    slug: 'svc-miyawaki-butterfly',
    detail: [800, 1000],
    text: 'Dense native mini-forests and nectar-rich pollinator gardens that support birds, insects and a healthier ecosystem.',
    includes: ['Dense native mini-forests', 'Nectar-rich pollinator gardens', 'Homes for birds and insects'],
    alt: 'A stone path through dense native planting and bright flowers, with butterflies in the sunlight',
  },
  {
    name: 'Automated water irrigation',
    slug: 'svc-irrigation',
    detail: [800, 1000],
    text: 'Drip and sprinkler systems, custom layouts and automatic timers that save water and effort.',
    includes: ['Drip systems', 'Sprinkler systems', 'Custom layouts', 'Automatic timers'],
    alt: 'Pop-up sprinklers watering a lawn beside a wall-mounted irrigation timer and drip lines',
  },
];

const pad = (i: number) => String(i).padStart(2, '0');
const a = SITE.address;
---

<LandscapeLayout
  title="Landscaping Services & Garden Design in Chennai"
  description="Laughing Earth Landscaping Studio, Chennai: landscape and hardscape design, landscape maintenance, gardening services, Miyawaki and butterfly gardens, and automated irrigation. Where nature meets design."
>
  <section class="hero chapter" aria-labelledby="lh-title">
    <video id="lh-video" class="bleed" poster={withBase('/images/poster-land-hero-banner.webp')} muted loop playsinline disablepictureinpicture preload="auto" aria-hidden="true" tabindex="-1">
      <source src={withBase('/videos/land-hero-banner.mp4')} type="video/mp4" />
    </video>
    <div class="hero-shade"></div>
    <div class="hero-copy">
      <p class="eyebrow">Landscaping · {a.city}</p>
      <h1 id="lh-title">Gardens designed <em>to grow with you</em></h1>
      <p class="hero-small">Garden design, lawns, vertical and terrace gardens, stone paving and ongoing care for homes and offices across Chennai.</p>
    </div>
  </section>

  <!-- 2. Services: the banner dissolves into a large title, then the ring alone (services-stage.ts) -->
  <section class="svc-ch chapter" id="services" data-svc-stage data-own-motion aria-labelledby="services-title">
    <div class="svc-bg" aria-hidden="true"></div>
    <div class="svc-head">
      <h2 id="services-title" class="svc-title">Our <em>services</em></h2>
      <p class="svc-lede">Comprehensive outdoor solutions: conceptual design, development, installation and ongoing maintenance.</p>
    </div>

    <div class="svc-ring">
      <div class="ring" data-ring role="region" aria-roledescription="carousel" aria-label="Our services">
        <div class="ring-stage" data-ring-stage>
          <ul class="ring-track" data-ring-track role="list">
            {
              services.map((s, i) => (
                <li
                  class="ring-card"
                  data-ring-card
                  data-name={s.name}
                  data-detail={pic(`${s.slug}-detail.webp`)}
                  data-detail-w={s.detail[0]}
                  data-detail-h={s.detail[1]}
                  data-detail-wide={pic(`${s.slug}-720.webp`)}
                  role="group"
                  aria-roledescription="slide"
                  aria-label={`${i + 1} of ${services.length}: ${s.name}`}
                >
                  <button class="ring-open" type="button" data-ring-open tabindex={i === 0 ? 0 : -1} aria-label={`${s.name}: see details`}>
                    <img src={pic(`${s.slug}-480.webp`)} width="480" height="600" alt={s.alt} loading="lazy" decoding="async" draggable="false" />
                    <span class="ring-over" aria-hidden="true">
                      <span class="ring-title">{s.name}</span>
                    </span>
                    <span class="ring-more" aria-hidden="true"><Icon name="plus" size={18} /></span>
                  </button>
                  <div class="ring-detail sr-only">
                    <h3>{s.name}</h3>
                    <p>{s.text}</p>
                    <ul>{s.includes.map((x) => <li>{x}</li>)}</ul>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="ring-controls">
          <button class="ring-btn" type="button" data-ring-prev aria-label="Previous service"><Icon name="chevron-left" size={20} /></button>
          <p class="ring-status" aria-live="polite">
            <span class="ring-count"><span data-ring-current>01</span> / {pad(services.length)}</span>
            <span class="sr-only" data-ring-name>{services[0].name}</span>
            <span class="ring-hint" aria-hidden="true">Tap a card for details</span>
          </p>
          <button class="ring-btn" type="button" data-ring-next aria-label="Next service"><Icon name="chevron-right" size={20} /></button>
        </div>
      </div>
    </div>
  </section>

  <!-- Details panel: the front card zooms up into it (service-ring.ts) -->
  <dialog class="svc-dialog" data-svc-dialog aria-labelledby="svc-d-title">
    <div class="svc-d-panel">
      <span class="svc-d-face" data-svc-d-face aria-hidden="true"></span>
      <figure class="svc-d-media" data-svc-d-media>
        <picture>
          <source media="(max-width: 800px)" data-svc-d-wide />
          <img data-svc-d-img alt="" decoding="async" />
        </picture>
      </figure>
      <div class="svc-d-copy" data-svc-d-copy>
        <p class="svc-d-num" data-svc-d-num></p>
        <h3 id="svc-d-title" class="svc-d-title" data-svc-d-title>Service</h3>
        <p class="svc-d-text" data-svc-d-text></p>
        <p class="svc-d-sub">What's included</p>
        <ul class="svc-d-list" data-svc-d-list></ul>
        <p class="svc-d-note">Every project starts with a site visit and a written quote.</p>
        <div class="svc-d-actions">
          <a class="svc-d-call" href={SITE.phoneHref}>Or call {SITE.phoneDisplay}</a>
          <a class="pill primary svc-d-cta" data-svc-d-cta href={whatsappLink(WHATSAPP_MESSAGES.landscaping)} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-event-label="landscaping_service_quote">Contact us for quotes</a>
        </div>
      </div>
      <button class="svc-d-close" type="button" data-svc-d-close aria-label="Close details" autofocus><Icon name="close" size={20} /></button>
    </div>
  </dialog>

  <!-- The enquiry card belongs to the banner: on desktop it is positioned over it
       (landscape.css), so its place in the markup only matters on phones, where
       it now follows the services instead of interrupting the dissolve. -->
  <section class="form-chapter chapter" data-tone="pool" id="enquire" aria-label="Quick enquiry">
    <aside class="card" data-card>
      <div class="card-form">
        <p class="card-eyebrow"><span>Plan my garden</span><i></i></p>
        <p class="card-intro">Tell us your name and we'll carry on the conversation on WhatsApp.</p>
        <form data-card-form>
          <div class="field"><label for="c-name">Name</label><input id="c-name" name="name" autocomplete="name" maxlength="80" required /><i class="focusline"></i></div>
          <div class="morph" data-morph>
            <div class="field"><label for="c-phone">Phone</label><input id="c-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="20" pattern="[0-9+ \(\)\-]{8,20}" tabindex="-1" /><i class="focusline"></i></div>
          </div>
          <button class="pill primary" type="submit" data-card-send data-event="whatsapp_click" data-event-label="landscaping_hero">Continue on WhatsApp</button>
        </form>
        <button class="pill ghost" type="button" data-card-mode>Ask for a call back</button>
        <small class="card-trust">WhatsApp opens with your message ready. Nothing sends until you tap send.</small>
      </div>
      <div class="card-done" hidden>
        <p class="card-eyebrow"><span>Thank you</span><i></i></p>
        <div class="done-line"><span>Your message</span></div>
        <div class="done-line"><span><em>is ready in WhatsApp.</em></span></div>
      </div>
    </aside>
  </section>

  <!-- 3. The reference page's layout: about, vision and commitment, contact -->
  <section class="studio studio-about" id="about" aria-labelledby="about-title">
    <div class="studio-wrap about-grid">
      <div class="about-copy" data-rise>
        <h2 id="about-title">Outdoor spaces deserve <em>great design too</em></h2>
        <p class="about-text">
          We believe outdoor spaces deserve the same creativity and attention as indoor ones. From lush gardens to
          elegant stone pathways and bespoke hardscape features, we bring every element together for harmonious
          outdoor experiences that are timeless, practical and inspiring.
        </p>
      </div>
      <figure class="about-figure" data-rise style="--d: 1">
        <img
          src={pic('about-aerial-1400.webp')}
          srcset={`${pic('about-aerial-800.webp')} 800w, ${pic('about-aerial-1400.webp')} 1400w`}
          sizes="(min-width: 900px) 46vw, 100vw"
          width="1400"
          height="933"
          alt="Aerial view of a landscaped estate: a planted roof garden, curving stone-paved drives, lawns, flower beds and pergolas"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="studio studio-vc" id="vision" aria-label="Our vision and commitment">
    <div class="studio-wrap vc-grid">
      <div class="vc-item" data-rise>
        <h2>Our <em>vision</em></h2>
        <p>
          To transform everyday outdoor spaces into extraordinary green environments where design, nature and
          functionality come together, and to inspire people to experience the beauty of nature in their everyday
          lives.
        </p>
      </div>
      <div class="vc-item" data-rise style="--d: 1">
        <h2>Our <em>commitment</em></h2>
        <p>
          Quality craftsmanship, thoughtful design, reliable execution and sustainable solutions, from the first concept
          to the final finishing touch.
        </p>
      </div>
    </div>
  </section>

  <section class="studio studio-cta" id="contact" aria-labelledby="contact-title">
    <div class="studio-wrap">
      <div class="cta-panel" data-rise>
        <h2 id="contact-title">Let’s bring your outdoor space <em>to life</em></h2>
        <p>Tell us about your garden, terrace or commercial space and we will design something that stands the test of time.</p>
        <ul class="cta-lines" role="list">
          <li><Icon name="phone" size={18} /><a href={SITE.phoneHref}>{SITE.phoneDisplay}</a></li>
          <li><Icon name="mail" size={18} /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><Icon name="pin" size={18} /><span>{a.locality}, {a.city}</span></li>
        </ul>
        <div class="cta-actions">
          <a class="pill primary" href={whatsappLink(WHATSAPP_MESSAGES.landscaping)} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-event-label="landscaping_contact">Chat on WhatsApp</a>
          <a class="pill ghost" href={NAV.contact.href}>Book a site visit</a>
        </div>
      </div>
    </div>
  </section>

  <!-- data-own-motion: the footer is short now, so the chapter engine's scrubbed entrance would never finish and its headings would stay blurred -->
  <footer class="ink foot-ch chapter" data-own-motion>
    <div class="foot-grid">
      <div>
        <a class="wordmark" href="#top"><img src={mark.src} width="48" height="48" alt="" /><span>{SITE.name}</span></a>
        <p>{SITE.brandLine}</p>
        <p><a href={SITE.instagram} target="_blank" rel="noopener noreferrer">Follow us on Instagram</a></p>
      </div>
      <nav aria-labelledby="foot-explore">
        <h2 id="foot-explore">Explore</h2>
        <ul>{Object.values(NAV).map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="foot-policies">
        <h2 id="foot-policies">Policies</h2>
        <ul>{POLICIES.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </nav>
      <div>
        <h2>Visit or call</h2>
        <address>
          <p>{a.street}, {a.locality}, {a.city}, {a.region} {a.postalCode}</p>
          <p><a href={SITE.phoneHref}>{SITE.phoneDisplay}</a></p>
          <p><a href={whatsappLink(WHATSAPP_MESSAGES.general)} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-event-label="footer">WhatsApp us</a></p>
          <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </address>
      </div>
    </div>
    <p class="foot-word" aria-hidden="true">{SITE.name}</p>
    <div class="foot-base">
      <p>&copy; <span data-current-year>{new Date().getFullYear()}</span> {SITE.name}. All rights reserved.</p>
      <PypCredit />
    </div>
  </footer>
</LandscapeLayout>

<script>
  import { init as ring } from '../scripts/landscaping/service-ring';
  import { init as rise } from '../scripts/landscaping/rise';

  ring();
  rise();
</script>
