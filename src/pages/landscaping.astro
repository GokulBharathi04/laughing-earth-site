---
import { withBase } from '../lib/url';
import LandscapeLayout from '../layouts/LandscapeLayout.astro';
import BgVideo from '../components/BgVideo.astro';
import credits from '../../data/landscaping-credits.json';
import { PATTERNS, VIEW, type Pattern } from '../lib/paving-patterns';
import mark from '../assets/brand/logo-mark.webp';
import { SITE, NAV, POLICIES, FORMSPREE_ENDPOINT, whatsappLink, WHATSAPP_MESSAGES } from '../config/site';

// Photographs: open-licence pictures of paving and stonework (credited in the
// footer) until the client's own project photos arrive; see IMAGES-NEEDED.md.
const img = (name: string) => ({
  src: withBase(`/images/land/${name}.webp`),
  srcset: `${withBase(`/images/land/${name}-800.webp`)} 800w, ${withBase(`/images/land/${name}.webp`)} 1600w`,
});

// Hero facts, carried over from the first landscaping page.
const facts = [
  { title: 'Across Chennai', text: 'Working from our nursery in Villivakkam.' },
  { title: 'Design to upkeep', text: 'One team from the first sketch to regular care.' },
  { title: 'Plants that suit Chennai', text: 'Chosen for local heat, monsoon and shade.' },
  { title: 'Site visit', text: 'We see the space before we quote. Fee <mark class="tbc">to confirm</mark>.' },
];

const rows = [
  {
    title: 'Sandstone patios',
    text: 'Indian sandstone or Kota flags on a compacted, levelled base, laid with a slight fall so monsoon rain runs off instead of pooling at the door.',
    photo: 'patio-barn',
    alt: 'A wide patio of sandstone flags with benches and planting beside a lawn',
    size: 'wide',
  },
  {
    title: 'Brick paths',
    text: 'Clay brick paviours in herringbone, basketweave or running bond, held by a firm edge so the pattern never creeps into the lawn.',
    photo: 'brick-herringbone',
    alt: 'Close-up of brick paviours in brown, grey and tan laid in herringbone',
    size: 'tall',
  },
  {
    title: 'Crazy paving and stepping stones',
    text: 'Broken flags fitted like a puzzle with tight joints, or single stones set into the grass along the line people really walk.',
    photo: 'crazy-paving',
    alt: 'Irregular flagstones fitted together as crazy paving up to a doorway',
    size: 'square',
  },
  {
    title: 'Granite drives',
    text: "Granite setts, the hard stone Tamil Nadu is known for, laid on a deep base so a driveway takes a car every day.",
    photo: 'granite-setts',
    alt: 'A long avenue paved in small grey granite setts under trees',
    size: 'mid',
  },
  {
    title: 'Steps, walls and edging',
    text: 'Stone steps, low retaining walls and raised beds that hold a slope, frame a border and give you somewhere to sit.',
    photo: 'temple-granite',
    alt: 'Large dressed granite blocks fitted in courses, at the Big Temple in Thanjavur',
    size: 'tall',
  },
] as const;

// The paving chooser. Facts are general properties of each material; prices
// wait for the client. Colours are the materials' own tones for the drawing.
const materials = [
  {
    id: 'brick',
    name: 'Clay brick paviours',
    photo: 'brick-moss',
    alt: 'Old clay brick paviours with moss growing in the joints',
    looks: 'Warm terracotta reds that deepen with age.',
    sun: 'Stays warm, never scorching.',
    rain: 'Textured faces grip; shaded joints need an occasional sweep.',
    best: 'Paths, courtyards and edging.',
  },
  {
    id: 'sandstone',
    name: 'Indian sandstone',
    photo: 'sandstone-wet-panel',
    alt: 'Wet sandstone flags in rust, grey and buff tones',
    looks: 'Riven flags in mixed buffs, greys and rust.',
    sun: 'Light tones stay cooler underfoot.',
    rain: 'The riven face grips; sealing keeps stains out.',
    best: 'Patios, terraces and wide paths.',
  },
  {
    id: 'crazy',
    name: 'Crazy paving',
    photo: 'crazy-paving-panel',
    alt: 'Irregular grey flagstones fitted together with narrow joints',
    looks: 'Irregular flags of sandstone, Kota or granite offcuts.',
    sun: 'Depends on the stone; pale offcuts stay cooler.',
    rain: 'Plenty of joints, so water drains quickly.',
    best: 'Informal paths and spaces around trees.',
  },
  {
    id: 'granite',
    name: 'Granite setts',
    photo: 'granite-setts-panel',
    alt: 'Small grey granite setts in curved rows',
    looks: 'Small, hard blocks in greys, flamed or split.',
    sun: 'Dark granite heats up, so we suggest the paler greys.',
    rain: 'Flamed and split faces grip in heavy rain.',
    best: 'Driveways and anything a car drives on.',
  },
] as const;

const patternOrder: Pattern[] = ['herringbone', 'basketweave', 'running-bond', 'random-flags'];

const curtain = [
  { video: 'land-rain-stones', caption: 'Rain on stone: a good base lets it run off, not under.' },
  { video: 'gallery-land-sprinkler-lawn', caption: 'Lawns set up with watering, so they root before the heat.' },
  { video: 'land-stone-water', caption: "Stone at the water's edge, laid to stay put." },
];

const steps = [
  {
    lead: 'On the first visit,',
    text: 'we walk the site, measure it, and look at where water stands after rain. You see real stone samples, not a catalogue.',
    photo: 'kota-slabs',
    alt: 'Four grey-green Kota stone slabs laid out on the ground',
  },
  {
    lead: 'Then a drawing.',
    text: 'You get a plan and a written quote: every square foot of paving, every step and every plant, priced line by line.',
    photo: 'pavers-study',
    alt: "A 1914 pen study by Umberto Boccioni of a man laying paving stones",
  },
  {
    lead: 'On site,',
    text: 'our team digs out, lays and compacts the base, sets each stone to a fall and fills the joints. Then the planting goes in.',
    photo: 'setts-laying',
    alt: 'A worker kneeling to set granite setts along the edge of a path',
  },
  {
    lead: 'After the first monsoon,',
    text: 'we check levels and joints, and regular garden care keeps lawns cut, beds weeded and paving swept.',
    video: 'land-slab-cut',
  },
];

// Clients, with their logos (Wikimedia Commons and the companies' own sites;
// see IMAGES-NEEDED.md). w/h are the trimmed files' pixel sizes.
const clients = [
  { name: 'Switch Mobility', file: 'switch', w: 171, h: 33 },
  { name: 'PMJ Jewels', file: 'pmj', w: 160, h: 160 },
  { name: 'TVS Motor Company', file: 'tvs', w: 354, h: 64 },
  { name: 'Lucas TVS', file: 'lucas-tvs', w: 240, h: 55 },
  { name: 'Indian Oil', file: 'indian-oil', w: 134, h: 160 },
  { name: 'Hindustan Petroleum', file: 'hp', w: 126, h: 160 },
  { name: 'CA India', file: 'ca', w: 212, h: 160 },
  { name: 'Zoho', file: 'zoho', w: 371, h: 160 },
  { name: 'Equitas Small Finance Bank', file: 'equitas', w: 172, h: 60 },
  { name: 'HDFC Bank', file: 'hdfc', w: 955, h: 160 },
  { name: 'Shriram Group', file: 'shriram', w: 532, h: 160 },
  { name: 'L&T', file: 'lt', w: 160, h: 160 },
  { name: 'IDFC First Bank', file: 'idfc', w: 452, h: 160 },
  { name: 'Parker', file: 'parker', w: 416, h: 160 },
  { name: 'Eone Technologies', file: 'eone', w: 439, h: 96 },
].map((c) => {
  // Same visual weight for every mark: size by area, not by height, so a wide
  // wordmark is not shrunk to a sliver and a square badge does not dominate.
  const ratio = c.w / c.h;
  const height = Math.min(64, Math.round(46 / Math.sqrt(ratio)) + 14);
  return { ...c, height, width: Math.round(height * ratio) };
});

const faqs = [
  {
    q: 'How much does a garden or patio cost?',
    a: 'It depends on the size of the space, the stone or plants, and how deep the base must be. After the site visit we send a written quote with every item listed. Typical rates are <mark class="tbc">to confirm</mark>.',
  },
  {
    q: 'How long does a project take?',
    a: 'A balcony, small patio or path can be ready in days; a full garden with paving, lawn and planting takes longer. You get a timeline with the quote. Typical durations are <mark class="tbc">to confirm</mark>.',
  },
  {
    q: 'Which areas do you cover?',
    a: 'We are based in Villivakkam and work across Chennai. Projects outside the city are <mark class="tbc">to confirm</mark>; ask us with your location.',
  },
  {
    q: 'Do you offer maintenance plans?',
    a: 'Yes. We can visit regularly to mow, prune, feed, replant and sweep the paving, for gardens we built and ones we did not. Visit frequency and plan prices are <mark class="tbc">to confirm</mark>.',
  },
  {
    q: 'Which plants and stone suit Chennai?',
    a: 'Plants that handle heat, humidity and heavy rain: hardy shrubs, palms, flowering creepers and native species. Underfoot, pale sandstone or Kota for patios, brick for paths, granite setts for drives.',
  },
  {
    q: 'Will paving be slippery in the monsoon?',
    a: 'We use riven, flamed or textured faces outside, never polished ones, and lay every surface to a fall so water runs off quickly.',
  },
  {
    q: 'Will the paving sink or crack?',
    a: 'Most failures start underneath. We dig out, compact a proper sub-base, and go deeper wherever a car will drive.',
  },
  {
    q: 'Can you work on a terrace or a small balcony?',
    a: 'Yes. We plan planters, soil and any paving for the weight and drainage a terrace can take, and choose plants that cope with rooftop sun and wind.',
  },
];

const propertyTypes = ['Independent house', 'Villa', 'Apartment balcony or terrace', 'Office or commercial', 'Other'];
const a = SITE.address;
---

<LandscapeLayout
  title="Landscaping Services, Garden Design & Stone Paving in Chennai"
  description="Landscaping services in Chennai by Laughing Earth: garden design, lawns, vertical and terrace gardens and maintenance, plus stone paving: sandstone patios, brick paths, crazy paving and granite drives. Book a site visit."
>
  <section class="hero chapter" aria-labelledby="lh-title">
    <video id="lh-video" class="bleed" poster={withBase('/images/poster-land-hero-banner.webp')} muted loop playsinline disablepictureinpicture preload="auto" aria-hidden="true" tabindex="-1">
      <source src={withBase('/videos/land-hero-banner-1080.mp4')} type="video/mp4" media="(min-width: 768px)" />
      <source src={withBase('/videos/land-hero-banner-720.mp4')} type="video/mp4" />
    </video>
    <div class="hero-shade"></div>
    <div class="scanlines"></div>
    <div class="hero-copy">
      <p class="eyebrow">Landscaping · {a.city}</p>
      <h1 id="lh-title">Gardens designed <em>to grow with you</em></h1>
      <p class="hero-small">Garden design, lawns, vertical and terrace gardens, stone paving and ongoing care for homes and offices across Chennai.</p>
    </div>
    <button class="video-toggle" type="button" data-video-toggle aria-controls="lh-video" aria-pressed="false" aria-label="Pause background video"><i></i></button>
  </section>

  <section class="form-chapter chapter" data-tone="pool" id="enquire" aria-label="Quick enquiry">
    <aside class="card" data-card>
      <div class="card-form">
        <p class="card-eyebrow"><span>Plan my garden</span><i></i></p>
        <p class="card-intro">Tell us your name and we'll carry on the conversation on WhatsApp.</p>
        <form data-card-form>
          <div class="field"><label for="c-name">Name</label><input id="c-name" name="name" autocomplete="name" maxlength="80" required /><i class="focusline"></i></div>
          <div class="morph" data-morph>
            <div class="field"><label for="c-phone">Phone</label><input id="c-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="20" pattern="[0-9+ \(\)\-]{8,20}" tabindex="-1" /><i class="focusline"></i></div>
          </div>
          <button class="pill primary" type="submit" data-card-send data-event="whatsapp_click" data-event-label="landscaping_hero">Continue on WhatsApp</button>
        </form>
        <button class="pill ghost" type="button" data-card-mode>Ask for a call back</button>
        <small class="card-trust">WhatsApp opens with your message ready. Nothing sends until you tap send.</small>
      </div>
      <div class="card-done" hidden>
        <p class="card-eyebrow"><span>Thank you</span><i></i></p>
        <div class="done-line"><span>Your message</span></div>
        <div class="done-line"><span><em>is ready in WhatsApp.</em></span></div>
      </div>
    </aside>
  </section>

  <section class="cine intro-ch chapter" aria-labelledby="intro-title">
    <div class="plate"><span class="mask"><span class="plate-num">01</span></span><span class="mask"><span class="plate-ttl">The ground</span></span></div>
    <BgVideo hd class="bleed" src="/videos/land-story-gardener-soil" poster="/images/poster-land-story-gardener-soil.webp" />
    <div class="shade"></div><div class="scanlines"></div>
    <div class="copy">
      <h2 id="intro-title">Paving first.<br /><em>Then the green.</em></h2>
      <p class="lede">A garden is only as good as the ground you walk on. We lay the patio, the paths and the steps first, then plant around them. From a single balcony to a villa lawn, we design the space around how you live, plant it with species that suit Chennai's climate, and stay on to keep it healthy.</p>
      <ul class="facts" role="list">
        {facts.map((f) => <li><strong>{f.title}</strong><span set:html={f.text} /></li>)}
      </ul>
    </div>
    <figure class="intro-figure">
      <img {...img('stonework-chelsea')} sizes="380px" width="828" height="920" alt="Honed stone bench set into a curved dry-stone wall, with broad curved stone steps and flowering borders" loading="lazy" decoding="async" />
      <figcaption>
        <strong>Show-garden stonework, RHS Chelsea 2024</strong>
        <ul>
          <li>Honed stone benches set into the wall</li>
          <li>Curved steps with split-face edges</li>
          <li>Dry-stone walling under smooth coping</li>
        </ul>
      </figcaption>
    </figure>
  </section>

  <section class="plan chapter" id="services" aria-labelledby="services-title">
    <video class="bleed" poster={withBase('/images/poster-land-services-aerial.webp')} muted loop playsinline disablepictureinpicture preload="none" aria-hidden="true" tabindex="-1">
      <source src={withBase('/videos/land-services-aerial-1080.mp4')} type="video/mp4" media="(min-width: 768px)" />
      <source src={withBase('/videos/land-services-aerial-720.mp4')} type="video/mp4" />
    </video>
    <div class="plan-shade"></div><div class="scanlines"></div>
    <div class="plate"><span class="mask"><span class="plate-num">02</span></span><span class="mask"><span class="plate-ttl">Our services</span></span></div>
    <div class="plan-note">
      <h2 id="services-title">Our <em>services</em></h2>
      <p class="lede">From planted borders and terraced beds to stone driveways and open lawns, we design, build and care for outdoor spaces as one complete landscape.</p>
    </div>
    </section>

  <section class="cine centered chapter" aria-labelledby="band-title">
    <BgVideo hd class="bleed" src="/videos/land-band-lawn-mowing" poster="/images/poster-land-band-lawn-mowing.webp" />
    <div class="shade"></div><div class="scanlines"></div>
    <div class="copy">
      <h2 id="band-title">A garden is <em>never finished</em></h2>
      <p class="lede">Edges trimmed, lawns fed, plants replaced when they tire. We look after it so you can enjoy it.</p>
    </div>
  </section>

  <section class="cine chapter" id="stonework" data-frames aria-labelledby="lay-title">
    <div class="plate"><span class="mask"><span class="plate-num">03</span></span><span class="mask"><span class="plate-ttl">The paving</span></span></div>
    {rows.map((r, i) => <img class:list={['bleed frame', i === 0 && 'on']} {...img(r.photo)} sizes="100vw" alt={r.alt} loading="lazy" decoding="async" />)}
    <div class="shade"></div><div class="scanlines"></div>
    <div class="copy">
      <h2 id="lay-title">What we <em>pave</em></h2>
      <p class="lede">Patios, paths, drives and steps in natural stone and brick, laid on a proper base with a fall for the rain.</p>
      <div class="tags">
        {rows.map((r, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'}>{r.title}</button>)}
      </div>
      <div class="panels" aria-live="polite">
        {rows.map((r, i) => <div class:list={['panel', i === 0 && 'on']}><p set:html={r.text} /></div>)}
      </div>
    </div>
  </section>

  <section class="cine pave-ch chapter" id="paving" data-frames aria-labelledby="pave-title">
    {materials.map((m, i) => <img class:list={['bleed frame', i === 0 && 'on']} {...img(m.photo)} sizes="100vw" alt={m.alt} loading="lazy" decoding="async" />)}
    <div class="shade"></div><div class="scanlines"></div>
    <div class="copy">
      <h2 id="pave-title">Choose your <em>paving</em></h2>
      <div class="tags">
        {materials.map((m, i) => <button type="button" data-stone={m.id} aria-pressed={i === 0 ? 'true' : 'false'}>{m.name}</button>)}
      </div>
      <div class="panels" aria-live="polite">
        {
          materials.map((m, i) => (
            <div class:list={['panel', i === 0 && 'on']}>
              <dl class="specs">
                <div><dt>Looks</dt><dd>{m.looks}</dd></div>
                <div><dt>In May sun</dt><dd>{m.sun}</dd></div>
                <div><dt>In the monsoon</dt><dd>{m.rain}</dd></div>
                <div><dt>Best for</dt><dd>{m.best}</dd></div>
                <div><dt>Price</dt><dd>Per square foot, <mark class="tbc">to confirm</mark></dd></div>
              </dl>
            </div>
          ))
        }
      </div>
    </div>
    <div class="drawing">
      <fieldset>
        <legend>Pattern</legend>
        {
          patternOrder.map((p, i) => (
            <label class="chip"><input type="radio" name="pattern" value={p} checked={i === 0} /><span>{PATTERNS[p].label}</span></label>
          ))
        }
      </fieldset>
      <svg class="pave-svg" data-stone="brick" viewBox={`0 0 ${VIEW.w} ${VIEW.h}`} role="img" aria-label="Drawing of the chosen paving laid in the chosen pattern">
        {
          patternOrder.map((p, i) => (
            <g class:list={['pave-layout', i === 0 && 'on']} data-pattern={p}>
              {PATTERNS[p].units.map((u) => <rect x={u.x} y={u.y} width={u.w} height={u.h} class={`t${u.shade}`} />)}
            </g>
          ))
        }
      </svg>
    </div>
  </section>

  <section class="cine chapter" data-frames aria-labelledby="curtain-title">
    <div class="plate"><span class="mask"><span class="plate-num">04</span></span><span class="mask"><span class="plate-ttl">The weather</span></span></div>
    {
      curtain.map((c, i) => (
        <div class:list={['frame-wrap frame', i === 0 && 'on']}>
          <BgVideo hd src={`/videos/${c.video}`} poster={`/images/poster-${c.video}.webp`} />
        </div>
      ))
    }
    <div class="shade"></div><div class="scanlines"></div>
    <div class="copy">
      <h2 id="curtain-title">Sun and <em>monsoon</em></h2>
      <p class="lede">Chennai gardens sit two exams a year: May heat and the northeast monsoon. We choose plants that take both, and lay every stone to a fall so rain runs off instead of sitting on top.</p>
      <div class="tags">
        {['Rain on stone', 'Lawns', "Water's edge"].map((t, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>)}
      </div>
      <div class="panels" aria-live="polite">
        {curtain.map((c, i) => <div class:list={['panel', i === 0 && 'on']}><p>{c.caption}</p></div>)}
      </div>
    </div>
  </section>

  <section class="cine chapter" id="process" data-frames aria-labelledby="steps-title">
    <div class="plate"><span class="mask"><span class="plate-num">05</span></span><span class="mask"><span class="plate-ttl">The process</span></span></div>
    {
      steps.map((s, i) =>
        s.video ? (
          <div class:list={['frame-wrap frame', i === 0 && 'on']}>
            <BgVideo hd src={`/videos/${s.video}`} poster={`/images/poster-${s.video}.webp`} />
          </div>
        ) : (
          <img class:list={['bleed frame', i === 0 && 'on']} {...img(s.photo!)} sizes="100vw" alt={s.alt} loading="lazy" decoding="async" />
        ),
      )
    }
    <div class="shade"></div><div class="scanlines"></div>
    <div class="copy">
      <h2 id="steps-title">From visit <em>to first rain</em></h2>
      <p class="lede">Four stages, one team, and a written quote before anything is dug.</p>
      <div class="tags">
        {steps.map((_, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'}>Stage {i + 1} of 4</button>)}
      </div>
      <div class="panels" aria-live="polite">
        {steps.map((s, i) => <div class:list={['panel', i === 0 && 'on']}><p><strong>{s.lead}</strong> {s.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="ink chapter" id="clients" aria-labelledby="clients-title">
    <img class="bleed ink-bg" src={withBase('/images/poster-gallery-land-garden-sunset.webp')} alt="" loading="lazy" decoding="async" />
    <div class="ink-shade"></div>
    <div class="plate"><span class="mask"><span class="plate-num">06</span></span><span class="mask"><span class="plate-ttl">The clients</span></span></div>
    <h2 id="clients-title">Our <em>clients</em></h2>
    <p class="lede">Some of the companies we have worked with.</p>
    <ul class="client-grid" role="list">
      {
        clients.map((c) => (
          <li><img src={withBase(`/images/clients/${c.file}.webp`)} alt={c.name} width={c.width} height={c.height} style={`--logo-w:${c.width}px`} loading="lazy" decoding="async" /></li>
        ))
      }
    </ul>
  </section>

  <section class="ink chapter" id="questions" aria-labelledby="qa-title">
    <img class="bleed ink-bg" {...img('path-hedge')} sizes="100vw" alt="" loading="lazy" decoding="async" />
    <div class="ink-shade"></div>
    <div class="plate"><span class="mask"><span class="plate-num">07</span></span><span class="mask"><span class="plate-ttl">The questions</span></span></div>
    <h2 id="qa-title">Questions</h2>
    <div class="q-grid">
      {
        [faqs.slice(0, 4), faqs.slice(4)].map((col) => (
          <div class="q-col">
            {col.map((f) => (
              <details class="q-row" name="landscaping-faq">
                <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
                <p set:html={f.a} />
              </details>
            ))}
          </div>
        ))
      }
    </div>
    <div class="q-actions">
      <a class="pill primary" href="#visit">Book a site visit</a>
      <a class="pill ghost" href={whatsappLink(WHATSAPP_MESSAGES.landscaping)} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-event-label="landscaping_faq">Ask on WhatsApp</a>
    </div>
  </section>

  <section class="visit-ch chapter" id="visit" aria-labelledby="visit-title">
    <img class="bleed" {...img('patio-barn')} sizes="100vw" alt="A sandstone patio with benches and parasols beside a lawn" loading="lazy" decoding="async" />
    <div class="contact-shade"></div><div class="scanlines"></div>
    <div class="plate"><span class="mask"><span class="plate-num">08</span></span><span class="mask"><span class="plate-ttl">The visit</span></span></div>
    <div class="visit-inner">
      <h2 id="visit-title">Book a <em>site visit</em></h2>
      <p class="lede">Tell us about the space. We call back to arrange a visit, then send a written quote.</p>
      <ol class="progress" aria-hidden="true">
        <li class="active">You</li><li>The property</li><li>The idea</li>
      </ol>
      <form action={FORMSPREE_ENDPOINT} method="POST" data-enquiry-form data-event="form_submit" data-event-label="landscaping_enquiry">
        <input type="hidden" name="_subject" value="New landscaping enquiry" />
        <div class="step" data-step>
          <div class="field"><label for="v-name">Name</label><input id="v-name" type="text" name="name" autocomplete="name" required maxlength="80" /><i class="focusline"></i></div>
          <div class="field"><label for="v-phone">Phone</label><input id="v-phone" type="tel" name="phone" autocomplete="tel" inputmode="tel" required maxlength="20" pattern="[0-9+ \(\)\-]{8,20}" aria-describedby="phone-desc" /><i class="focusline"></i><small id="phone-desc">We call to fix a time for the site visit.</small></div>
          <div class="step-nav"><span></span><button type="button" class="pill primary" data-next>Continue</button></div>
        </div>
        <div class="step" data-step>
          <div class="field">
            <label for="v-property">Property</label>
            <select id="v-property" name="property" required>
              <option value="" disabled selected>Choose one</option>
              {propertyTypes.map((p) => <option>{p}</option>)}
            </select><i class="focusline"></i>
          </div>
          <div class="step-nav"><button type="button" class="pill ghost" data-prev>Back</button><button type="button" class="pill primary" data-next>Continue</button></div>
        </div>
        <div class="step" data-step>
          <div class="field"><label for="v-msg">What would you like laid or planted?</label><textarea id="v-msg" name="message" rows="2" maxlength="1000" placeholder="e.g. A sandstone patio and a brick path to the gate"></textarea></div>
          <div class="step-nav"><button type="button" class="pill ghost" data-prev>Back</button><button type="submit" class="pill primary">Send and book a visit</button></div>
        </div>
        <p class="visit-status" data-enquiry-status role="status" aria-live="polite"></p>
      </form>
      <p class="visit-alt">Or call <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a> · {a.locality}, {a.city}</p>
    </div>
  </section>

  <footer class="ink foot-ch chapter">
    <div class="foot-grid">
      <div>
        <a class="wordmark" href="#top"><img src={mark.src} width="48" height="48" alt="" /><span>{SITE.name}</span></a>
        <p>{SITE.brandLine}</p>
        <p><a href={SITE.instagram} target="_blank" rel="noopener noreferrer">Follow us on Instagram</a></p>
      </div>
      <nav aria-labelledby="foot-explore">
        <h2 id="foot-explore">Explore</h2>
        <ul>{Object.values(NAV).map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="foot-policies">
        <h2 id="foot-policies">Policies</h2>
        <ul>{POLICIES.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </nav>
      <div>
        <h2>Visit or call</h2>
        <address>
          <p>{a.street}, {a.locality}, {a.city}, {a.region} {a.postalCode}</p>
          <p><a href={SITE.phoneHref}>{SITE.phoneDisplay}</a></p>
          <p><a href={whatsappLink(WHATSAPP_MESSAGES.general)} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-event-label="footer">WhatsApp us</a></p>
          <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </address>
      </div>
    </div>
    <p class="credits">
      Photographs of paving and stonework from Wikimedia Commons and Openverse:
      {
        credits.map((c, i) => (
          <>
            <a href={c.page} target="_blank" rel="noopener noreferrer">{c.title}</a>
            {c.creator ? ` by ${c.creator}` : ''}, {c.licenseUrl ? <a href={c.licenseUrl} target="_blank" rel="noopener noreferrer">{c.license}</a> : c.license}
            {i < credits.length - 1 ? '; ' : '. '}
          </>
        ))
      }
      Video clips from Mixkit (free licence).
    </p>
    <p class="foot-word" aria-hidden="true">{SITE.name}</p>
    <div class="foot-base">
      <p>&copy; <span data-current-year>{new Date().getFullYear()}</span> {SITE.name}. All rights reserved.</p>
      <p>{SITE.credit.label}</p>
    </div>
  </footer>
</LandscapeLayout>
