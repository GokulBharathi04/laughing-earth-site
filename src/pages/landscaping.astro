---
import { withBase } from '../lib/url';
import LandscapeLayout from '../layouts/LandscapeLayout.astro';
import Icon from '../components/Icon.astro';
import PypCredit from '../components/PypCredit.astro';
import mark from '../assets/brand/logo-mark.webp';
import { SITE, NAV, POLICIES, whatsappLink, WHATSAPP_MESSAGES } from '../config/site';

// Four parts, in the order the client set out:
//  1. the banner and its enquiry card, exactly as on the previous version;
//  2. the services, on a turning 3D ring (src/scripts/landscaping/service-ring.ts);
//  3. about, vision and commitment, and contact, laid out as in the
//     "Laughing Earth Landscape Studio" reference page, in this site's dusk palette;
//  4. the clients' logos, just above the footer (brought back Nov 2026).

// Pictures cut to size in /images/land-studio (see IMAGES-NEEDED.md).
const pic = (file: string) => withBase(`/images/land-studio/${file}`);

// Each service: the card shows the picture and name; the details panel tells
// the whole story. detail = 4:5 picture for the panel (its own pixel size),
// wide = 4:3 picture for the panel on phones.
//
// story = the client's own text for the service (Nov 2026, word for word), in
// one or more parts, each with the client's photos that belong to it
// (svc-…-g<n>-720/1200.webp, made from "Sample Images/Final Images"). The words
// show on the right of the details panel; the photos, in the same order and
// after the card's own picture, make the slider on the left (slidesOf). The
// card picture is left out of the photos so it is not shown twice. w/h are the
// 1200px file's size; pos is where a tall crop of a wide photo should sit
// (default: the middle). includes = the same text as a quick list.
type Photo = { n: number; w: number; h: number; alt: string; pos?: string; whole?: boolean };
type Part = { text: string; photos: Photo[] };
const services: { name: string; slug: string; detail: number[]; story: Part[]; includes: string[]; alt: string }[] = [
  {
    name: 'Landscape design',
    slug: 'svc-landscape-design',
    detail: [800, 1000],
    story: [
      {
        text: 'Landscape design is the art of transforming outdoor spaces into beautiful, green and refreshing environments. It involves the thoughtful selection and arrangement of natural elements such as trees, palms, plants, lawns, shrubs, flower beds and ground covers. At Laughing Earth Landscape Studio, we create thoughtfully planned green spaces that enhance the beauty, functionality and natural balance of your surroundings, bringing people closer to nature.',
        photos: [
          { n: 1, w: 1200, h: 800, alt: 'A planted border of flowering shrubs, ferns and a frangipani along a white house, with a boulder and a garden light', pos: '40% 50%' },
          { n: 3, w: 1200, h: 675, alt: 'A trimmed lawn bordered by palms, flower beds and garden lights in front of a house' },
        ],
      },
    ],
    includes: ['Trees and palms', 'Plants and shrubs', 'Lawns', 'Flower beds', 'Ground covers'],
    alt: 'A corner lawn framed by tropical planting, ferns and a spreading tree beside a garden wall',
  },
  {
    name: 'Hardscape design',
    slug: 'svc-hardscape-design',
    detail: [800, 1000],
    story: [
      {
        text: 'Hardscape design focuses on the structural and functional elements of outdoor spaces, combining durability with aesthetic appeal. It includes features such as natural stone paving, pathways, driveways, outdoor flooring, retaining walls, pergolas, garden steps, water fountains and seating areas. We thoughtfully integrate textures, materials and architectural elements to create elegant, practical and enduring outdoor spaces that complement the surrounding landscape.',
        photos: [
          { n: 1, w: 1200, h: 800, alt: 'Large stone paving slabs set with grass joints, leading across a driveway to the gate' },
          { n: 2, w: 1200, h: 800, alt: 'Pale stone pavers laid in grass along a planted driveway' },
          { n: 4, w: 1200, h: 675, alt: 'A stone-paved pool deck with a circular inlay and round decorative stones', pos: '18% 50%' },
          { n: 5, w: 1200, h: 800, alt: 'A poolside walk of large stone slabs with a cobble border, leading to a lit gazebo', pos: '12% 50%' },
        ],
      },
    ],
    includes: ['Natural stone paving', 'Pathways and driveways', 'Outdoor flooring', 'Retaining walls', 'Pergolas', 'Garden steps', 'Water fountains and seating areas'],
    alt: 'A circular cobblestone driveway with an inlaid ring pattern, edged with planting under a spreading tree',
  },
  {
    name: 'Landscape maintenance',
    slug: 'svc-landscape-maintenance',
    detail: [800, 1000],
    story: [
      {
        text: 'A beautiful landscape deserves consistent care and attention to flourish throughout the year. Our landscape maintenance services are designed to keep your outdoor spaces healthy, vibrant and visually appealing in every season. From lawn mowing, pruning, trimming and plant care to fertilisation, weed control, irrigation management and seasonal maintenance, we provide comprehensive solutions to preserve the beauty and health of your landscape. Our goal is to ensure your gardens remain fresh, well-maintained and inviting all year round.',
        photos: [
          { n: 1, w: 1200, h: 800, alt: 'A gardener trimming shrubs while another pressure-washes a stone path' },
        ],
      },
    ],
    includes: ['Lawn mowing, pruning and trimming', 'Plant care', 'Fertilisation', 'Weed control', 'Irrigation management', 'Seasonal maintenance'],
    alt: 'A gardener pruning a lush planted bed of tropical foliage beside a lawn',
  },
  {
    name: 'Gardening services',
    slug: 'svc-gardening-services',
    detail: [800, 1000],
    story: [
      {
        text: 'Gardening is more than just planting; it is about creating and nurturing living spaces that grow beautifully over time. We offer comprehensive gardening services, including plant selection, garden setup, soil preparation, potting, repotting, planting, fertilisation and general garden care. Whether it is a small home garden, a residential landscape or a commercial green space, we bring the right expertise and attention to detail to help every garden thrive.',
        photos: [
          // A labelled collage: shown whole in the slider, since a crop would cut its words
          { n: 1, w: 1199, h: 1312, alt: 'Our gardening work in five pictures: garden maintenance, soil preparation, potting, re-potting, and plant care and health', whole: true },
        ],
      },
    ],
    includes: ['Plant selection', 'Garden setup', 'Soil preparation', 'Potting and repotting', 'Planting', 'Fertilisation', 'General garden care'],
    alt: 'A Laughing Earth gardener trimming a shrub with garden shears',
  },
  {
    name: 'Miyawaki & butterfly gardens',
    slug: 'svc-miyawaki-butterfly',
    detail: [800, 1000],
    // Two parts, so each kind of garden sits next to its own photos.
    story: [
      {
        text: 'We specialise in creating nature-inspired green spaces that promote biodiversity, ecological balance and a thriving natural environment. Our Miyawaki gardens use the innovative Miyawaki method to develop dense, native mini-forests in relatively small spaces, encouraging natural growth and creating habitats for birds, insects and other wildlife.',
        photos: [
          { n: 1, w: 1200, h: 801, alt: 'A dense young Miyawaki forest of native trees over mulched ground' },
          { n: 2, w: 1200, h: 800, alt: 'A Miyawaki mini-forest edged with a rope fence and a small sign' },
          { n: 3, w: 1200, h: 675, alt: 'The thick native canopy of a Miyawaki forest seen from above' },
        ],
      },
      {
        text: 'Complementing this approach, our butterfly gardens feature carefully selected nectar-rich flowering plants and host plants that attract and support butterflies and other pollinators throughout their life cycle. By bringing together native vegetation, flowering plants and natural habitats, we create vibrant, sustainable green spaces that reconnect people with nature and contribute to a healthier ecosystem.',
        photos: [
          { n: 5, w: 1200, h: 800, alt: 'A butterfly garden with its sign, flowering beds and a stone bench', pos: '16% 50%' },
        ],
      },
    ],
    includes: ['Dense native mini-forests', 'Nectar-rich flowering plants', 'Host plants for butterflies', 'Habitats for birds, insects and wildlife'],
    alt: 'A butterfly garden of lantana, pentas and other nectar-rich flowers beside a stone-edged path',
  },
  {
    name: 'Automated water irrigation',
    slug: 'svc-irrigation',
    detail: [800, 1000],
    story: [
      {
        text: 'Efficient watering is essential for maintaining healthy and thriving landscapes. Our automated water irrigation solutions are designed to deliver the right amount of water to plants and lawns at the right time, ensuring consistent hydration while reducing water wastage and manual effort. From drip irrigation and sprinkler systems to customised irrigation layouts and automatic timer controls, we provide smart watering solutions tailored to the specific requirements of each outdoor space. Our goal is to promote healthier plant growth, improve water efficiency and make garden maintenance more convenient and sustainable.',
        photos: [
          { n: 2, w: 1200, h: 800, alt: 'A terrace planter watered by drip lines, with a wall-mounted irrigation controller' },
        ],
      },
    ],
    includes: ['Drip irrigation', 'Sprinkler systems', 'Customised irrigation layouts', 'Automatic timer controls'],
    alt: 'A gardener laying drip irrigation lines in a planted bed below the wall-mounted irrigation controller',
  },
];
const photo = (slug: string, n: number, w: 720 | 1200) => pic(`${slug}-g${n}-${w}.webp`);
// The pictures side of the details panel: the card's own picture first, then
// every photo from the story, in the order the story tells them.
type Slide = { hero: true; pos: string } | ({ hero: false } & Photo & { pos: string });
const slidesOf = (s: (typeof services)[number]): Slide[] => [
  { hero: true, pos: '50% 50%' },
  ...s.story.flatMap((part) => part.photos.map((ph) => ({ hero: false as const, ...ph, pos: ph.pos ?? '50% 50%' }))),
];

// Clients, with their logos (Wikimedia Commons and the companies' own sites;
// see IMAGES-NEEDED.md). w/h are the trimmed files' pixel sizes.
const clients = [
  { name: 'Switch Mobility', file: 'switch', w: 171, h: 33 },
  { name: 'PMJ Jewels', file: 'pmj', w: 160, h: 160 },
  { name: 'TVS Motor Company', file: 'tvs', w: 354, h: 64 },
  { name: 'Lucas TVS', file: 'lucas-tvs', w: 240, h: 55 },
  { name: 'Indian Oil', file: 'indian-oil', w: 134, h: 160 },
  { name: 'Hindustan Petroleum', file: 'hp', w: 126, h: 160 },
  { name: 'CA India', file: 'ca', w: 212, h: 160 },
  { name: 'Zoho', file: 'zoho', w: 371, h: 160 },
  { name: 'Equitas Small Finance Bank', file: 'equitas', w: 172, h: 60 },
  { name: 'HDFC Bank', file: 'hdfc', w: 955, h: 160 },
  { name: 'Shriram Group', file: 'shriram', w: 532, h: 160 },
  { name: 'L&T', file: 'lt', w: 160, h: 160 },
  { name: 'IDFC First Bank', file: 'idfc', w: 452, h: 160 },
  { name: 'Parker', file: 'parker', w: 416, h: 160 },
  { name: 'Eone Technologies', file: 'eone', w: 439, h: 96 },
].map((c) => {
  // Same visual weight for every mark: size by area, not by height, so a wide
  // wordmark is not shrunk to a sliver and a square badge does not dominate.
  const ratio = c.w / c.h;
  const height = Math.min(64, Math.round(46 / Math.sqrt(ratio)) + 14);
  return { ...c, height, width: Math.round(height * ratio) };
});

// How many photos fan out behind each ring card on hover (svc-…-fan<k>.webp,
// 4:5, 360 x 450): more of the service's own photos, a few from the client's
// first batch where the second had too few. See IMAGES-NEEDED.md.
const fanCount: Record<string, number> = {
  'svc-landscape-design': 3,
  'svc-hardscape-design': 3,
  'svc-landscape-maintenance': 2,
  'svc-gardening-services': 3,
  'svc-miyawaki-butterfly': 3,
  'svc-irrigation': 2,
};

const pad = (i: number) => String(i).padStart(2, '0');
const a = SITE.address;
---

<LandscapeLayout
  title="Landscaping Services & Garden Design in Chennai"
  description="Laughing Earth Landscaping Studio, Chennai: landscape and hardscape design, landscape maintenance, gardening services, Miyawaki and butterfly gardens, and automated irrigation. Where nature meets design."
>
  <section class="hero chapter" aria-labelledby="lh-title">
    <video id="lh-video" class="bleed" poster={withBase('/images/poster-land-hero-banner.webp')} muted loop playsinline disablepictureinpicture preload="auto" aria-hidden="true" tabindex="-1">
      <source src={withBase('/videos/land-hero-banner.mp4')} type="video/mp4" />
    </video>
    <div class="hero-shade"></div>
    <div class="hero-copy">
      <p class="eyebrow">Landscaping · {a.city}</p>
      <h1 id="lh-title">Gardens designed <em>to grow with you</em></h1>
      <p class="hero-small">Garden design, lawns, vertical and terrace gardens, stone paving and ongoing care for homes and offices across Chennai.</p>
    </div>
  </section>

  <!-- 2. Services: the banner dissolves straight into the ring (services-stage.ts).
       The large "Our services" title screen was removed at the client's request
       (Nov 2026); the heading stays for screen readers and the page outline. -->
  <section class="svc-ch chapter" id="services" data-svc-stage data-own-motion aria-labelledby="services-title">
    <div class="svc-bg" aria-hidden="true"></div>
    <h2 id="services-title" class="sr-only">Our services</h2>

    <div class="svc-ring">
      <div class="ring" data-ring role="region" aria-roledescription="carousel" aria-label="Our services">
        <div class="ring-stage" data-ring-stage>
          <ul class="ring-track" data-ring-track role="list">
            {
              services.map((s, i) => (
                <li
                  class="ring-card"
                  data-ring-card
                  data-name={s.name}
                  data-detail={pic(`${s.slug}-detail.webp`)}
                  role="group"
                  aria-roledescription="slide"
                  aria-label={`${i + 1} of ${services.length}: ${s.name}`}
                >
                  <!-- Hand fan: more of this service's photos, hidden behind the
                       card until a pointer hovers the front card (landscape.css).
                       data-src: fetched only where hover exists (service-ring.ts). -->
                  <span class="ring-fan" data-ring-fan data-count={fanCount[s.slug]} aria-hidden="true">
                    {Array.from({ length: fanCount[s.slug] }, (_, k) => (
                      <img data-src={pic(`${s.slug}-fan${k + 1}.webp`)} alt="" width="360" height="450" decoding="async" draggable="false" />
                    ))}
                  </span>
                  <button class="ring-open" type="button" data-ring-open tabindex={i === 0 ? 0 : -1} aria-label={`${s.name}: see details`}>
                    <img src={pic(`${s.slug}-480.webp`)} width="480" height="600" alt={s.alt} loading="lazy" decoding="async" draggable="false" />
                    <span class="ring-over" aria-hidden="true">
                      <span class="ring-title">{s.name}</span>
                    </span>
                    <span class="ring-more" aria-hidden="true"><Icon name="plus" size={18} /></span>
                  </button>
                  <div class="ring-detail sr-only">
                    <h3>{s.name}</h3>
                    {s.story.map((part) => <p>{part.text}</p>)}
                    <ul>{s.includes.map((x) => <li>{x}</li>)}</ul>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="ring-controls">
          <button class="ring-btn" type="button" data-ring-prev aria-label="Previous service"><Icon name="chevron-left" size={20} /></button>
          <p class="ring-status" aria-live="polite">
            <span class="ring-count"><span data-ring-current>01</span> / {pad(services.length)}</span>
            <span class="sr-only" data-ring-name>{services[0].name}</span>
            <span class="ring-hint" aria-hidden="true">Tap a card for details</span>
          </p>
          <button class="ring-btn" type="button" data-ring-next aria-label="Next service"><Icon name="chevron-right" size={20} /></button>
        </div>
      </div>
    </div>
  </section>

  <!-- Details panel: the front card zooms up into it (service-ring.ts).
       The way back sits top left, where a back button lives on a phone; the
       browser's own Back (Android's back button, the iPhone edge swipe) also
       closes the panel instead of leaving the page. -->
  <dialog class="svc-dialog" data-svc-dialog aria-labelledby="svc-d-title">
    <div class="svc-d-panel">
      <span class="svc-d-face" data-svc-d-face aria-hidden="true"></span>
      <nav class="svc-d-crumbs" data-svc-d-chrome aria-label="Breadcrumb">
        <ol>
          <li>
            <button class="svc-d-back" type="button" data-svc-d-back autofocus>
              <Icon name="chevron-left" size={18} /><span><span class="sr-only">Back to </span>Our services</span>
            </button>
          </li>
          <li class="svc-d-here" aria-current="page" data-svc-d-crumb>{services[0].name}</li>
        </ol>
      </nav>
      <!-- Pictures side: every photo of the opened service in one slider (the
           card's own picture first), turning on its own every few seconds, with
           arrows, a pause button and swipe (service-ring.ts). Hidden sets load
           nothing. The words stay on the right. -->
      <figure class="svc-d-media" data-svc-d-media>
        {
          services.map((s, i) => {
            const slides = slidesOf(s);
            return (
              <div class="svc-d-slides" data-svc-d-slides={i} role="region" aria-roledescription="carousel" aria-label={`Photos: ${s.name}`} hidden>
                {slides.map((sl, j) => (
                  <div class="svc-d-slide" data-svc-d-slide role="group" aria-roledescription="slide" aria-label={`${j + 1} of ${slides.length}`} style={`--pos:${sl.pos};--fit:${!sl.hero && sl.whole ? 'contain' : 'cover'}`}>
                    {sl.hero ? (
                      <picture>
                        <source media="(max-width: 800px)" srcset={pic(`${s.slug}-720.webp`)} width="720" height="540" />
                        <img src={pic(`${s.slug}-detail.webp`)} width={s.detail[0]} height={s.detail[1]} alt={s.alt} decoding="async" draggable="false" />
                      </picture>
                    ) : (
                      <img
                        src={photo(s.slug, sl.n, 720)}
                        srcset={`${photo(s.slug, sl.n, 720)} 720w, ${photo(s.slug, sl.n, 1200)} 1200w`}
                        sizes="(max-width: 800px) 100vw, 580px"
                        width={sl.w}
                        height={sl.h}
                        alt={sl.alt}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    )}
                  </div>
                ))}
              </div>
            );
          })
        }
        <div class="svc-d-pager" data-svc-d-pager data-svc-d-chrome>
          <button class="svc-d-pbtn" type="button" data-svc-d-prev aria-label="Previous photo"><Icon name="chevron-left" size={18} /></button>
          <p class="svc-d-pcount" data-svc-d-pcount><span data-svc-d-pnow>01</span><span aria-hidden="true"> / </span><span class="sr-only"> of </span><span data-svc-d-pall>01</span></p>
          <button class="svc-d-pbtn" type="button" data-svc-d-next aria-label="Next photo"><Icon name="chevron-right" size={18} /></button>
          <button class="svc-d-pbtn svc-d-play" type="button" data-svc-d-play aria-label="Pause the slideshow">
            <Icon name="pause" size={14} class="is-pause" /><Icon name="play" size={14} class="is-play" />
          </button>
        </div>
        <span class="svc-d-progress" aria-hidden="true"><i data-svc-d-bar></i></span>
      </figure>
      <div class="svc-d-copy" data-svc-d-copy>
        <p class="svc-d-num" data-svc-d-num></p>
        <h3 id="svc-d-title" class="svc-d-title" data-svc-d-title>Service</h3>
        <!-- One story per service, shown for the card that was opened: the
             words only, since every photo is on the pictures side. -->
        {
          services.map((s, i) => (
            <div class="svc-d-story" data-svc-d-story={i} hidden>
              {s.story.map((part) => <p class="svc-d-text">{part.text}</p>)}
            </div>
          ))
        }
        <p class="svc-d-sub">What's included</p>
        <ul class="svc-d-list" data-svc-d-list></ul>
        <p class="svc-d-note">Every project starts with a site visit and a written quote.</p>
        <div class="svc-d-actions">
          <a class="svc-d-call" href={SITE.phoneHref}>Or call {SITE.phoneDisplay}</a>
          <a class="pill primary svc-d-cta" data-svc-d-cta href={whatsappLink(WHATSAPP_MESSAGES.landscaping)} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-event-label="landscaping_service_quote">Contact us for quotes</a>
        </div>
      </div>
      <button class="svc-d-close" type="button" data-svc-d-close data-svc-d-chrome aria-label="Close details"><Icon name="close" size={20} /></button>
    </div>
  </dialog>

  <!-- The enquiry card belongs to the banner: on desktop it is positioned over it
       (landscape.css), so its place in the markup only matters on phones, where
       it now follows the services instead of interrupting the dissolve. -->
  <section class="form-chapter chapter" data-tone="pool" id="enquire" aria-label="Quick enquiry">
    <aside class="card" data-card>
      <div class="card-form">
        <p class="card-eyebrow"><span>Plan my garden</span><i></i></p>
        <p class="card-intro">Tell us your name and we'll carry on the conversation on WhatsApp.</p>
        <form data-card-form>
          <div class="field"><label for="c-name">Name</label><input id="c-name" name="name" autocomplete="name" autocapitalize="words" enterkeyhint="send" maxlength="80" required /><i class="focusline"></i></div>
          <div class="morph" data-morph>
            <div class="field"><label for="c-phone">Phone</label><input id="c-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" enterkeyhint="send" maxlength="20" pattern="[0-9+ \(\)\-]{8,20}" tabindex="-1" /><i class="focusline"></i></div>
          </div>
          <button class="pill primary" type="submit" data-card-send data-event="whatsapp_click" data-event-label="landscaping_hero">Continue on WhatsApp</button>
        </form>
        <button class="pill ghost" type="button" data-card-mode>Ask for a call back</button>
        <small class="card-trust">WhatsApp opens with your message ready. Nothing sends until you tap send.</small>
      </div>
      <div class="card-done" hidden>
        <p class="card-eyebrow"><span>Thank you</span><i></i></p>
        <div class="done-line"><span>Your message</span></div>
        <div class="done-line"><span><em>is ready in WhatsApp.</em></span></div>
      </div>
    </aside>
  </section>

  <!-- 3. The reference page's layout: about, vision and commitment, contact -->
  <section class="studio studio-about" id="about" aria-labelledby="about-title">
    <div class="studio-wrap about-grid">
      <div class="about-copy" data-rise>
        <h2 id="about-title">Outdoor spaces deserve <em>great design too</em></h2>
        <p class="about-text">
          We believe outdoor spaces deserve the same creativity and attention as indoor ones. From lush gardens to
          elegant stone pathways and bespoke hardscape features, we bring every element together for harmonious
          outdoor experiences that are timeless, practical and inspiring.
        </p>
      </div>
      <figure class="about-figure" data-rise style="--d: 1">
        <img
          src={pic('about-aerial-1400.webp')}
          srcset={`${pic('about-aerial-800.webp')} 800w, ${pic('about-aerial-1400.webp')} 1400w`}
          sizes="(min-width: 900px) 46vw, 100vw"
          width="1400"
          height="933"
          alt="Aerial view of a landscaped estate: a planted roof garden, curving stone-paved drives, lawns, flower beds and pergolas"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="studio studio-vc" id="vision" aria-label="Our vision and commitment">
    <div class="studio-wrap vc-grid">
      <div class="vc-item" data-rise>
        <h2>Our <em>vision</em></h2>
        <p>
          To transform everyday outdoor spaces into extraordinary green environments where design, nature and
          functionality come together, and to inspire people to experience the beauty of nature in their everyday
          lives.
        </p>
      </div>
      <div class="vc-item" data-rise style="--d: 1">
        <h2>Our <em>commitment</em></h2>
        <p>
          Quality craftsmanship, thoughtful design, reliable execution and sustainable solutions, from the first concept
          to the final finishing touch.
        </p>
      </div>
    </div>
  </section>

  <section class="studio studio-cta" id="contact" aria-labelledby="contact-title">
    <div class="studio-wrap">
      <div class="cta-panel" data-rise>
        <h2 id="contact-title">Let’s bring your outdoor space <em>to life</em></h2>
        <p>Tell us about your garden, terrace or commercial space and we will design something that stands the test of time.</p>
        <ul class="cta-lines" role="list">
          <li><Icon name="phone" size={18} /><a href={SITE.phoneHref}>{SITE.phoneDisplay}</a></li>
          <li><Icon name="mail" size={18} /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><Icon name="pin" size={18} /><span>{a.locality}, {a.city}</span></li>
        </ul>
        <div class="cta-actions">
          <a class="pill primary" href={whatsappLink(WHATSAPP_MESSAGES.landscaping)} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-event-label="landscaping_contact">Chat on WhatsApp</a>
          <a class="pill ghost" href={NAV.contact.href}>Book a site visit</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Clients, just above the footer. A flowing section with the one-way rise
       (rise.ts), like its neighbours, not a scrubbed chapter. -->
  <section class="studio studio-clients" id="clients" aria-labelledby="clients-title">
    <div class="studio-wrap">
      <div class="clients-head" data-rise>
        <h2 id="clients-title">Our <em>clients</em></h2>
        <p>Some of the companies we have worked with.</p>
      </div>
      <ul class="client-grid" role="list" data-rise style="--d: 1">
        {
          clients.map((c) => (
            <li><img src={withBase(`/images/clients/${c.file}.webp`)} alt={c.name} width={c.width} height={c.height} style={`--logo-w:${c.width}px`} loading="lazy" decoding="async" /></li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- data-own-motion: the footer is short now, so the chapter engine's scrubbed entrance would never finish and its headings would stay blurred -->
  <footer class="ink foot-ch chapter" data-own-motion>
    <div class="foot-grid">
      <div>
        <a class="wordmark" href="#top"><img src={mark.src} width="48" height="48" alt="" /><span>{SITE.name}</span></a>
        <p>{SITE.brandLine}</p>
        <p><a href={SITE.instagram} target="_blank" rel="noopener noreferrer">Follow us on Instagram</a></p>
      </div>
      <nav aria-labelledby="foot-explore">
        <h2 id="foot-explore">Explore</h2>
        <ul>{Object.values(NAV).map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="foot-policies">
        <h2 id="foot-policies">Policies</h2>
        <ul>{POLICIES.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </nav>
      <div>
        <h2>Visit or call</h2>
        <address>
          <p>{a.street}, {a.locality}, {a.city}, {a.region} {a.postalCode}</p>
          <p><a href={SITE.phoneHref}>{SITE.phoneDisplay}</a></p>
          <p><a href={whatsappLink(WHATSAPP_MESSAGES.general)} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-event-label="footer">WhatsApp us</a></p>
          <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </address>
      </div>
    </div>
    <p class="foot-word" aria-hidden="true">{SITE.name}</p>
    <div class="foot-base">
      <p>&copy; <span data-current-year>{new Date().getFullYear()}</span> {SITE.name}. All rights reserved.</p>
      <PypCredit />
    </div>
  </footer>
</LandscapeLayout>

<script>
  import { init as ring } from '../scripts/landscaping/service-ring';
  import { init as rise } from '../scripts/landscaping/rise';

  ring();
  rise();
</script>
