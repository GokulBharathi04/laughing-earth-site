---
import { withBase } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import BgVideo from '../components/BgVideo.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import credits from '../../data/landscaping-credits.json';
import { PATTERNS, VIEW, type Pattern } from '../lib/paving-patterns';
import { SITE, FORMSPREE_ENDPOINT, whatsappLink, WHATSAPP_MESSAGES } from '../config/site';

// Photographs: open-licence pictures of paving and stonework (credited in the
// footer) until the client's own project photos arrive; see IMAGES-NEEDED.md.
const img = (name: string) => ({
  src: withBase(`/images/land/${name}.webp`),
  srcset: `${withBase(`/images/land/${name}-800.webp`)} 800w, ${withBase(`/images/land/${name}.webp`)} 1600w`,
});

// Video stills from the landscaping clips (Mixkit), used as photographs.
const still = (clip: string) => ({ src: withBase(`/images/poster-${clip}.webp`) });

// Hero facts, carried over from the first landscaping page.
const facts = [
  { title: 'Across Chennai', text: 'Working from our nursery in Villivakkam.' },
  { title: 'Design to upkeep', text: 'One team from the first sketch to regular care.' },
  { title: 'Plants that suit Chennai', text: 'Chosen for local heat, monsoon and shade.' },
  { title: 'Site visit', text: 'We see the space before we quote. Fee <mark class="tbc">to confirm</mark>.' },
];

// Garden services (client to review once their service list and pricing arrive).
const gardenRows = [
  {
    title: 'Garden design',
    text: 'A layout drawn for your plot, light and budget: paths, beds, seating, and plants that thrive in Chennai.',
    media: still('gallery-land-garden-stream'),
    alt: 'A stone-lined stream running past red and yellow flowering plants',
    size: 'wide',
  },
  {
    title: 'Lawn setup',
    text: 'Soil preparation, levelling and grass planting, with watering arranged so the lawn takes root.',
    media: still('gallery-land-sprinkler-lawn'),
    alt: 'A sprinkler watering a green lawn',
    size: 'tall',
  },
  {
    title: 'Vertical gardens',
    text: 'Living green walls for balconies, facades and indoor spaces, planted to stay full and easy to water.',
    media: still('gallery-land-watering-garden'),
    alt: 'Potted plants being watered on a balcony',
    size: 'square',
  },
  {
    title: 'Terrace gardens',
    text: 'Planters, light soil mixes and plants that handle rooftop sun and wind, for flats and offices alike.',
    media: still('gallery-land-nursery'),
    alt: 'Hanging baskets of pink flowers in a plant nursery',
    size: 'mid',
  },
  {
    title: 'Garden maintenance',
    text: 'Regular visits for mowing, pruning, feeding and replanting. Plans <mark class="tbc">to confirm</mark>.',
    media: still('gallery-land-garden-sunset'),
    alt: 'A planted garden at sunset with hills behind',
    size: 'tall',
    pos: 'center 85%',
  },
] as const;

const rows = [
  {
    title: 'Sandstone patios',
    text: 'Indian sandstone or Kota flags on a compacted, levelled base, laid with a slight fall so monsoon rain runs off instead of pooling at the door.',
    photo: 'patio-barn',
    alt: 'A wide patio of sandstone flags with benches and planting beside a lawn',
    size: 'wide',
  },
  {
    title: 'Brick paths',
    text: 'Clay brick paviours in herringbone, basketweave or running bond, held by a firm edge so the pattern never creeps into the lawn.',
    photo: 'brick-herringbone',
    alt: 'Close-up of brick paviours in brown, grey and tan laid in herringbone',
    size: 'tall',
  },
  {
    title: 'Crazy paving and stepping stones',
    text: 'Broken flags fitted like a puzzle with tight joints, or single stones set into the grass along the line people really walk.',
    photo: 'crazy-paving',
    alt: 'Irregular flagstones fitted together as crazy paving up to a doorway',
    size: 'square',
  },
  {
    title: 'Granite drives',
    text: "Granite setts, the hard stone Tamil Nadu is known for, laid on a deep base so a driveway takes a car every day.",
    photo: 'granite-setts',
    alt: 'A long avenue paved in small grey granite setts under trees',
    size: 'mid',
  },
  {
    title: 'Steps, walls and edging',
    text: 'Stone steps, low retaining walls and raised beds that hold a slope, frame a border and give you somewhere to sit.',
    photo: 'temple-granite',
    alt: 'Large dressed granite blocks fitted in courses, at the Big Temple in Thanjavur',
    size: 'tall',
  },
] as const;

// The paving chooser. Facts are general properties of each material; prices
// wait for the client. Colours are the materials' own tones for the drawing.
const materials = [
  {
    id: 'brick',
    name: 'Clay brick paviours',
    photo: 'brick-moss',
    alt: 'Old clay brick paviours with moss growing in the joints',
    looks: 'Warm terracotta reds that deepen with age.',
    sun: 'Stays warm, never scorching.',
    rain: 'Textured faces grip; shaded joints need an occasional sweep.',
    best: 'Paths, courtyards and edging.',
  },
  {
    id: 'sandstone',
    name: 'Indian sandstone',
    photo: 'sandstone-wet-panel',
    alt: 'Wet sandstone flags in rust, grey and buff tones',
    looks: 'Riven flags in mixed buffs, greys and rust.',
    sun: 'Light tones stay cooler underfoot.',
    rain: 'The riven face grips; sealing keeps stains out.',
    best: 'Patios, terraces and wide paths.',
  },
  {
    id: 'crazy',
    name: 'Crazy paving',
    photo: 'crazy-paving-panel',
    alt: 'Irregular grey flagstones fitted together with narrow joints',
    looks: 'Irregular flags of sandstone, Kota or granite offcuts.',
    sun: 'Depends on the stone; pale offcuts stay cooler.',
    rain: 'Plenty of joints, so water drains quickly.',
    best: 'Informal paths and spaces around trees.',
  },
  {
    id: 'granite',
    name: 'Granite setts',
    photo: 'granite-setts-panel',
    alt: 'Small grey granite setts in curved rows',
    looks: 'Small, hard blocks in greys, flamed or split.',
    sun: 'Dark granite heats up, so we suggest the paler greys.',
    rain: 'Flamed and split faces grip in heavy rain.',
    best: 'Driveways and anything a car drives on.',
  },
] as const;

const patternOrder: Pattern[] = ['herringbone', 'basketweave', 'running-bond', 'random-flags'];

const curtain = [
  { video: 'land-rain-stones', caption: 'Rain on stone: a good base lets it run off, not under.' },
  { video: 'gallery-land-sprinkler-lawn', caption: 'Lawns set up with watering, so they root before the heat.' },
  { video: 'land-stone-water', caption: "Stone at the water's edge, laid to stay put." },
];

const steps = [
  {
    lead: 'On the first visit,',
    text: 'we walk the site, measure it, and look at where water stands after rain. You see real stone samples, not a catalogue.',
    photo: 'kota-slabs',
    alt: 'Four grey-green Kota stone slabs laid out on the ground',
  },
  {
    lead: 'Then a drawing.',
    text: 'You get a plan and a written quote: every square foot of paving, every step and every plant, priced line by line.',
    photo: 'pavers-study',
    alt: "A 1914 pen study by Umberto Boccioni of a man laying paving stones",
  },
  {
    lead: 'On site,',
    text: 'our team digs out, lays and compacts the base, sets each stone to a fall and fills the joints. Then the planting goes in.',
    photo: 'setts-laying',
    alt: 'A worker kneeling to set granite setts along the edge of a path',
  },
  {
    lead: 'After the first monsoon,',
    text: 'we check levels and joints, and regular garden care keeps lawns cut, beds weeded and paving swept.',
    video: 'land-slab-cut',
  },
];

const faqs = [
  {
    q: 'How much does a garden or patio cost?',
    a: 'It depends on the size of the space, the stone or plants, and how deep the base must be. After the site visit we send a written quote with every item listed. Typical rates are <mark class="tbc">to confirm</mark>.',
  },
  {
    q: 'How long does a project take?',
    a: 'A balcony, small patio or path can be ready in days; a full garden with paving, lawn and planting takes longer. You get a timeline with the quote. Typical durations are <mark class="tbc">to confirm</mark>.',
  },
  {
    q: 'Which areas do you cover?',
    a: 'We are based in Villivakkam and work across Chennai. Projects outside the city are <mark class="tbc">to confirm</mark>; ask us with your location.',
  },
  {
    q: 'Do you offer maintenance plans?',
    a: 'Yes. We can visit regularly to mow, prune, feed, replant and sweep the paving, for gardens we built and ones we did not. Visit frequency and plan prices are <mark class="tbc">to confirm</mark>.',
  },
  {
    q: 'Which plants and stone suit Chennai?',
    a: 'Plants that handle heat, humidity and heavy rain: hardy shrubs, palms, flowering creepers and native species. Underfoot, pale sandstone or Kota for patios, brick for paths, granite setts for drives.',
  },
  {
    q: 'Will paving be slippery in the monsoon?',
    a: 'We use riven, flamed or textured faces outside, never polished ones, and lay every surface to a fall so water runs off quickly.',
  },
  {
    q: 'Will the paving sink or crack?',
    a: 'Most failures start underneath. We dig out, compact a proper sub-base, and go deeper wherever a car will drive.',
  },
  {
    q: 'Can you work on a terrace or a small balcony?',
    a: 'Yes. We plan planters, soil and any paving for the weight and drainage a terrace can take, and choose plants that cope with rooftop sun and wind.',
  },
];

const propertyTypes = ['Independent house', 'Villa', 'Apartment balcony or terrace', 'Office or commercial', 'Other'];
const a = SITE.address;
---

<BaseLayout
  title="Landscaping Services, Garden Design & Stone Paving in Chennai"
  description="Landscaping services in Chennai by Laughing Earth: garden design, lawns, vertical and terrace gardens and maintenance, plus stone paving: sandstone patios, brick paths, crazy paving and granite drives. Book a site visit."
  theme="landscaping"
  whatsappMessage={WHATSAPP_MESSAGES.landscaping}
>
  <!-- Hero: the garden on screen, the promise set large beneath it -->
  <section class="lh" data-tone="deep" data-hero-intro aria-labelledby="lh-title">
    <div class="lh__media" data-hero-media>
      <BgVideo id="lh-video" src="/videos/land-hero-villa-garden" poster="/images/poster-land-hero-villa-garden.webp" eager />
      <button class="lh__toggle" type="button" data-video-toggle aria-controls="lh-video" aria-pressed="false">
        <Icon name="pause" size={18} class="lh__pause" />
        <Icon name="play" size={18} class="lh__play" />
        <span class="sr-only">Pause background video</span>
      </button>
    </div>
    <div class="wrap lh__band">
      <h1 id="lh-title" class="lh__name">Gardens designed to grow with you</h1>
      <div class="lh__row" data-hero-item>
        <p class="lh__lead">Garden design, lawns, vertical and terrace gardens, stone paving and ongoing care for homes and offices across Chennai.</p>
        <div class="lh__actions">
          <Button href="#visit" size="lg" icon="arrow-right">Plan my garden</Button>
          <Button
            href={whatsappLink(WHATSAPP_MESSAGES.landscaping)}
            variant="outline"
            size="lg"
            icon="whatsapp"
            iconPosition="start"
            external
            data-event="whatsapp_click"
            data-event-label="landscaping_hero"
          >
            Chat on WhatsApp
          </Button>
        </div>
      </div>
      <ul class="lh__facts" role="list" data-hero-item>
        {
          facts.map((f) => (
            <li>
              <strong>{f.title}</strong>
              <span set:html={f.text} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Intro: the claim, beside the finished thing -->
  <section class="intro" data-tone="base" aria-labelledby="intro-title">
    <div class="wrap intro__grid">
      <div class="intro__copy" data-stagger>
        <h2 id="intro-title">Paving first.<br />Then the green.</h2>
        <p class="statement">
          A garden is only as good as the ground you walk on. We lay the patio, the paths and the steps first, then
          plant around them.
        </p>
        <p class="intro__more">
          From a single balcony to a villa lawn, we design the space around how you live, plant it with species that
          suit Chennai's climate, and stay on to keep it healthy.
        </p>
      </div>
      <figure class="intro__tall" data-clip-reveal>
        <BgVideo src="/videos/land-story-gardener-soil" poster="/images/poster-land-story-gardener-soil.webp" />
      </figure>
      <figure class="intro__small" data-clip-reveal>
        <img {...img('brick-path-1945')} sizes="(min-width: 1024px) 30vw, 50vw" width="1600" height="1147" alt="Black and white photograph of a brick path curving through a wooded garden" loading="lazy" decoding="async" />
        <figcaption>A winding brick path, 1945. Brick laid along a curve still goes down the same way.</figcaption>
      </figure>
    </div>
  </section>

  <!-- What we grow: an even zig-zag of picture and text -->
  <section class="lay" data-tone="alt" id="services" aria-labelledby="grow-title">
    <div class="wrap">
      <h2 id="grow-title" class="lay__head" data-split>What we grow</h2>
      <ul class="lay__rows" role="list">
        {
          gardenRows.map((r) => (
            <li class="lay__row" data-stagger>
              <div class="lay__text">
                <h3>{r.title}</h3>
                <p set:html={r.text} />
              </div>
              <figure class="lay__photo">
                <img
                  {...r.media}
                  width="1280"
                  height="720"
                  alt={r.alt}
                  style={'pos' in r ? `object-position: ${r.pos}` : undefined}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Lawn care: a video band that widens from an inset card as it scrolls past -->
  <section class="band" data-tone="deep" data-expand aria-labelledby="band-title">
    <div class="band__media" data-expand-media>
      <BgVideo src="/videos/land-band-lawn-mowing" poster="/images/poster-land-band-lawn-mowing.webp" />
    </div>
    <div class="wrap band__copy">
      <h2 id="band-title">A garden is never finished</h2>
      <p>Edges trimmed, lawns fed, plants replaced when they tire. We look after it so you can enjoy it.</p>
    </div>
  </section>

  <!-- What we pave: the same zig-zag, starting on the other side -->
  <section class="lay lay--mirror" data-tone="base" id="stonework" aria-labelledby="lay-title">
    <div class="wrap">
      <h2 id="lay-title" class="lay__head" data-split>What we pave</h2>
      <ul class="lay__rows" role="list">
        {
          rows.map((r) => (
            <li class="lay__row" data-stagger>
              <div class="lay__text">
                <h3>{r.title}</h3>
                <p>{r.text}</p>
              </div>
              <figure class="lay__photo">
                <img {...img(r.photo)} sizes="(min-width: 768px) 40vw, 100vw" width="1600" height="1200" alt={r.alt} loading="lazy" decoding="async" />
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- The live thing: choose a material, then a pattern, and see the path laid -->
  <section class="pave" data-tone="alt" id="paving" aria-labelledby="pave-title">
    <div class="wrap">
      <h2 id="pave-title" class="pave__head">Choose your paving</h2>
    </div>

    <fieldset class="pave__band">
      <legend class="sr-only">Paving material</legend>
      {
        materials.map((m, i) => (
          <label class="pave__panel">
            <input class="pave__radio" type="radio" name="material" value={m.id} checked={i === 0} />
            <img {...img(m.photo)} sizes="(min-width: 768px) 40vw, 60vw" width="1600" height="1200" alt={m.alt} loading="lazy" decoding="async" />
            <span class="pave__name">{m.name}</span>
          </label>
        ))
      }
    </fieldset>

    <div class="wrap pave__detail">
      <div class="pave__infos" aria-live="polite">
        {
          materials.map((m) => (
            <div class="pave__info" data-material={m.id}>
              <h3>{m.name}</h3>
              <dl>
                <div><dt>Looks</dt><dd>{m.looks}</dd></div>
                <div><dt>In May sun</dt><dd>{m.sun}</dd></div>
                <div><dt>In the monsoon</dt><dd>{m.rain}</dd></div>
                <div><dt>Best for</dt><dd>{m.best}</dd></div>
                <div><dt>Price</dt><dd>Per square foot, <mark class="tbc">to confirm</mark></dd></div>
              </dl>
            </div>
          ))
        }
      </div>

      <div class="pave__drawing">
        <fieldset class="pave__patterns">
          <legend>Pattern</legend>
          {
            patternOrder.map((p, i) => (
              <label class="pave__chip">
                <input type="radio" name="pattern" value={p} checked={i === 0} />
                <span>{PATTERNS[p].label}</span>
              </label>
            ))
          }
        </fieldset>
        <svg class="pave__svg" viewBox={`0 0 ${VIEW.w} ${VIEW.h}`} role="img" aria-label="Drawing of the chosen paving laid in the chosen pattern">
          {
            patternOrder.map((p) => (
              <g class="pave__layout" data-pattern={p}>
                {PATTERNS[p].units.map((u) => (
                  <rect x={u.x} y={u.y} width={u.w} height={u.h} class={`t${u.shade}`} />
                ))}
              </g>
            ))
          }
        </svg>
      </div>
    </div>
  </section>

  <!-- Monsoon: three full-screen clips, each sliding over the last -->
  <section class="curtain" data-tone="deep" aria-labelledby="curtain-title">
    <div class="wrap curtain__intro">
      <h2 id="curtain-title" data-split>Sun and monsoon</h2>
      <p>Chennai gardens sit two exams a year: May heat and the northeast monsoon. We choose plants that take both, and lay every stone to a fall so rain runs off instead of sitting on top.</p>
    </div>
    <div class="curtain__track">
      {
        curtain.map((c) => (
          <figure class="curtain__frame">
            <BgVideo src={`/videos/${c.video}`} poster={`/images/poster-${c.video}.webp`} />
            <figcaption>{c.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- Before / after -->
  <section class="ba-section" data-tone="base" aria-labelledby="ba-title">
    <div class="wrap ba-section__grid">
      <div class="ba-section__copy" data-stagger>
        <h2 id="ba-title">Before and after</h2>
        <p>Drag the line across the picture, or focus it and use the arrow keys, to compare the bare plot with the finished terrace and lawn.</p>
      </div>
      <div class="ba-section__slider">
        <BeforeAfter
          before="/images/landscaping-sample-before"
          after="/images/landscaping-sample-after"
          beforeAlt="A bare, dry plot behind a house before landscaping"
          afterAlt="The same plot with a lawn, paving and a pool after landscaping"
          label="Compare before and after landscaping"
          sample
        />
      </div>
    </div>
  </section>

  <!-- How it works: four stages down a diagonal -->
  <section class="steps" data-tone="alt" id="process" aria-labelledby="steps-title">
    <div class="wrap steps__grid">
      <h2 id="steps-title" class="steps__head" data-split>From visit to first rain</h2>
      {
        steps.map((s, i) => (
          <div class:list={['step', `step--${i + 1}`]} data-stagger>
            <figure class="step__media">
              {s.video ? (
                <BgVideo src={`/videos/${s.video}`} poster={`/images/poster-${s.video}.webp`} />
              ) : (
                <img {...img(s.photo!)} sizes="(min-width: 1024px) 36vw, 90vw" width="1600" height="1200" alt={s.alt} loading="lazy" decoding="async" />
              )}
            </figure>
            <p class="step__text">
              <strong>{s.lead}</strong> {s.text}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Questions beside a tall photograph -->
  <section class="qa" data-tone="base" aria-labelledby="qa-title">
    <div class="wrap qa__grid">
      <div class="qa__copy">
        <h2 id="qa-title" data-split>Questions</h2>
        <ul class="qa__facts" role="list">
          <li>{a.street}, {a.locality}, {a.city} {a.postalCode}</li>
          <li><a href={SITE.phoneHref}>{SITE.phoneDisplay}</a>, call or WhatsApp</li>
          <li>Working across Chennai</li>
        </ul>
        <div class="qa__list" data-stagger>
          {
            faqs.map((f) => (
              <details class="qa__item">
                <summary>{f.q}</summary>
                <p set:html={f.a} />
              </details>
            ))
          }
        </div>
        <div class="qa__actions">
          <Button href="#visit" size="lg">Book a site visit</Button>
          <a
            class="qa__link"
            href={whatsappLink(WHATSAPP_MESSAGES.landscaping)}
            target="_blank"
            rel="noopener noreferrer"
            data-event="whatsapp_click"
            data-event-label="landscaping_faq"
          >Ask on WhatsApp</a>
        </div>
      </div>
      <div class="qa__photos">
        <figure class="qa__tall">
          <img {...img('path-hedge')} sizes="(min-width: 1024px) 50vw, 100vw" width="1600" height="1067" alt="A flagstone path leading between two clipped yew hedges into a walled garden" loading="lazy" decoding="async" />
        </figure>
        <figure class="qa__square">
          <img {...img('sandstone-wet')} sizes="(min-width: 1024px) 16vw, 38vw" width="1024" height="926" alt="Wet sandstone flags in rust, grey and buff tones" loading="lazy" decoding="async" />
        </figure>
      </div>
    </div>
  </section>

  <!-- Visit card on a photograph -->
  <section class="visit" id="visit" data-tone="base" aria-labelledby="visit-title">
    <img class="visit__photo" {...img('patio-barn')} sizes="100vw" width="1600" height="900" alt="A sandstone patio with benches and parasols beside a lawn on a summer day" loading="lazy" decoding="async" />
    <div class="wrap visit__wrap">
      <div class="visit__card">
        <h2 id="visit-title">Book a site visit</h2>
        <p class="visit__addr">{a.street},<br />{a.locality}, {a.city} {a.postalCode}</p>
        <form
          class="visit__form"
          action={FORMSPREE_ENDPOINT}
          method="POST"
          data-enquiry-form
          data-event="form_submit"
          data-event-label="landscaping_enquiry"
        >
          <input type="hidden" name="_subject" value="New landscaping enquiry" />
          <label class="field">
            <span>Name</span>
            <input type="text" name="name" autocomplete="name" required maxlength="80" />
          </label>
          <label class="field">
            <span>Phone</span>
            <input type="tel" name="phone" autocomplete="tel" inputmode="tel" required maxlength="20" pattern="[0-9+ \(\)\-]{8,20}" />
          </label>
          <label class="field field--select">
            <span>Property</span>
            <select name="property" required>
              <option value="" disabled selected>Choose one</option>
              {propertyTypes.map((p) => <option>{p}</option>)}
            </select>
            <Icon name="chevron-right" size={18} class="field__chevron" />
          </label>
          <label class="field">
            <span>What would you like laid or planted?</span>
            <textarea name="message" rows="3" maxlength="1000" placeholder="e.g. A sandstone patio and a brick path to the gate"></textarea>
          </label>
          <button class="visit__submit" type="submit">Send and book a visit</button>
          <p class="visit__status" data-enquiry-status role="status" aria-live="polite"></p>
        </form>
        <p class="visit__alt">
          Or call <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a>
        </p>
      </div>
    </div>
  </section>

  <Fragment slot="credits">
    <p class="credits">
      Photographs of paving and stonework from Wikimedia Commons and Openverse:
      {
        credits.map((c, i) => (
          <>
            <a href={c.page} target="_blank" rel="noopener noreferrer">{c.title}</a>
            {c.creator ? ` by ${c.creator}` : ''}, {c.licenseUrl ? <a href={c.licenseUrl} target="_blank" rel="noopener noreferrer">{c.license}</a> : c.license}
            {i < credits.length - 1 ? '; ' : '. '}
          </>
        ))
      }
      Video clips from Mixkit (free licence).
    </p>
  </Fragment>
